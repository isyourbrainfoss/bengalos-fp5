diff --git a/src/calls-default-origin.c b/src/calls-default-origin.c
new file mode 100644
index 0000000..a45bccc
--- /dev/null
+++ b/src/calls-default-origin.c
@@ -0,0 +1,103 @@
+/*
+ * Copyright (C) 2026 The Calls authors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "calls-default-origin.h"
+
+gboolean
+calls_origin_name_is_imsd (const char *name,
+                           const char *id)
+{
+  if (g_strcmp0 (name, "imsd") == 0 || g_strcmp0 (name, "/imsd") == 0)
+    return TRUE;
+  if (g_strcmp0 (id, "imsd") == 0 || g_strcmp0 (id, "/imsd") == 0)
+    return TRUE;
+  return FALSE;
+}
+
+int
+calls_pick_tel_default_origin (const CallsOriginCandidate *candidates,
+                               guint                       n,
+                               gboolean                    prefer_imsd)
+{
+  int fallback = -1;
+
+  if (!candidates || n == 0)
+    return -1;
+
+  for (guint i = 0; i < n; i++) {
+    if (!candidates[i].usable)
+      continue;
+
+    if (fallback < 0)
+      fallback = (int) i;
+
+    if (prefer_imsd &&
+        candidates[i].kind == CALLS_ORIGIN_KIND_OFONO &&
+        calls_origin_name_is_imsd (candidates[i].name, candidates[i].id))
+      return (int) i;
+  }
+
+  return fallback;
+}
+
+gboolean
+calls_number_is_common_emergency (const char *number)
+{
+  if (g_strcmp0 (number, "112") == 0 ||
+      g_strcmp0 (number, "911") == 0 ||
+      g_strcmp0 (number, "999") == 0 ||
+      g_strcmp0 (number, "000") == 0)
+    return TRUE;
+
+  return FALSE;
+}
+
+int
+calls_pick_first_listed (const char              *target,
+                         const char * const * const *lists,
+                         guint                        n)
+{
+  if (!target || !lists)
+    return -1;
+
+  for (guint i = 0; i < n; i++) {
+    if (lists[i] && g_strv_contains (lists[i], target))
+      return (int) i;
+  }
+
+  return -1;
+}
+
+int
+calls_dial_origin_index (gboolean                    use_default,
+                         int                         explicit_index,
+                         const CallsOriginCandidate *candidates,
+                         guint                       n)
+{
+  if (!use_default)
+    return explicit_index;
+
+  return calls_pick_tel_default_origin (candidates, n, TRUE);
+}
+
+gboolean
+calls_ofono_modem_should_add (gboolean already_known,
+                              gboolean origin_present)
+{
+  return !already_known || !origin_present;
+}
+
+void
+calls_ofono_clear_on_vanish (GHashTable *modems,
+                             GListStore *origins)
+{
+  /* Origins hold their own modem ref. Drop them before the hash so
+   * dispose still has a live proxy if it looks at one. */
+  if (origins)
+    g_list_store_remove_all (origins);
+  if (modems)
+    g_hash_table_remove_all (modems);
+}
diff --git a/src/calls-default-origin.h b/src/calls-default-origin.h
new file mode 100644
index 0000000..4dcbf80
--- /dev/null
+++ b/src/calls-default-origin.h
@@ -0,0 +1,77 @@
+/*
+ * Copyright (C) 2026 The Calls authors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Choose a default origin for a tel: dial, and decide whether an oFono
+ * modem must be added again after the name vanishes from the bus.
+ */
+
+#pragma once
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+typedef enum {
+  CALLS_ORIGIN_KIND_OTHER = 0,
+  CALLS_ORIGIN_KIND_MM,
+  CALLS_ORIGIN_KIND_OFONO,
+  CALLS_ORIGIN_KIND_SIP,
+} CallsOriginKind;
+
+typedef struct {
+  CallsOriginKind kind;
+  const char *name;
+  const char *id;
+  gboolean usable; /* FALSE for an offline SIP account, or an offline modem */
+} CallsOriginCandidate;
+
+gboolean calls_origin_name_is_imsd (const char *name,
+                                    const char *id);
+
+/* Index of the origin to dial when default origins are on.
+ * When prefer_imsd is TRUE, a usable oFono origin named imsd (or id
+ * imsd or /imsd) wins. Otherwise, and when no such origin is usable,
+ * the first usable origin. -1 when none are usable.
+ * prefer_imsd is FALSE for USSD, which stays on the first usable origin.
+ */
+int calls_pick_tel_default_origin (const CallsOriginCandidate *candidates,
+                                   guint                       n,
+                                   gboolean                    prefer_imsd);
+
+/* First origin whose list contains target, or -1. Used so a keypad
+ * emergency number stays on the origin that advertises it (ModemManager
+ * when that origin is first), instead of moving to imsd.
+ */
+int calls_pick_first_listed (const char              *target,
+                             const char * const * const *lists,
+                             guint                        n);
+
+/* 112, 911, 999 and 000. A keypad dial of one of these stays on the
+ * first usable origin when no origin has advertised it yet.
+ */
+gboolean calls_number_is_common_emergency (const char *number);
+
+/* explicit_index is returned unchanged when use_default is FALSE,
+ * including when it points at a non-imsd origin.
+ */
+int calls_dial_origin_index (gboolean                    use_default,
+                             int                         explicit_index,
+                             const CallsOriginCandidate *candidates,
+                             guint                       n);
+
+/* TRUE when GetModems should create the origin. A modem that is still
+ * in the hash but whose origin was removed (oFono vanished, list cleared)
+ * must be added again.
+ */
+gboolean calls_ofono_modem_should_add (gboolean already_known,
+                                       gboolean origin_present);
+
+/* Drop modem proxies and origins together. Clearing only the list leaves
+ * the hash behind, and the next GetModems then skips the modem.
+ */
+void calls_ofono_clear_on_vanish (GHashTable *modems,
+                                  GListStore *origins);
+
+G_END_DECLS
