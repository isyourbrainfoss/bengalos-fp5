diff --git a/tests/test-default-origin.c b/tests/test-default-origin.c
new file mode 100644
index 0000000..cfdb4fa
--- /dev/null
+++ b/tests/test-default-origin.c
@@ -0,0 +1,237 @@
+/*
+ * Copyright (C) 2026 The Calls authors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Host test. Compiles with calls-default-origin.c and glib only.
+ */
+
+#include "calls-default-origin.h"
+
+static CallsOriginCandidate
+cand (CallsOriginKind kind,
+      const char     *name,
+      const char     *id,
+      gboolean        usable)
+{
+  CallsOriginCandidate c = { kind, name, id, usable };
+  return c;
+}
+
+static void
+test_imsd_online_beats_mm (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+    cand (CALLS_ORIGIN_KIND_SIP, "sip", "sip", TRUE),
+    cand (CALLS_ORIGIN_KIND_OFONO, "imsd", "ofono", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 2);
+  g_assert_cmpint (calls_dial_origin_index (TRUE, 0, c, G_N_ELEMENTS (c)), ==, 2);
+}
+
+static void
+test_imsd_path_id (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+    cand (CALLS_ORIGIN_KIND_OFONO, "modem", "/imsd", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 1);
+}
+
+static void
+test_imsd_absent_uses_mm (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+    cand (CALLS_ORIGIN_KIND_SIP, "sip", "sip", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 0);
+}
+
+static void
+test_imsd_offline_uses_mm (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+    cand (CALLS_ORIGIN_KIND_OFONO, "imsd", "/imsd", FALSE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 0);
+}
+
+static void
+test_imsd_not_in_list_uses_mm (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 0);
+  g_assert_cmpint (calls_pick_tel_default_origin (NULL, 0, TRUE), ==, -1);
+}
+
+static void
+test_explicit_origin_unchanged (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_OFONO, "imsd", "/imsd", TRUE),
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+  };
+
+  g_assert_cmpint (calls_dial_origin_index (FALSE, 1, c, G_N_ELEMENTS (c)), ==, 1);
+  g_assert_cmpint (calls_dial_origin_index (FALSE, 0, c, G_N_ELEMENTS (c)), ==, 0);
+  g_assert_cmpint (calls_dial_origin_index (FALSE, 1, NULL, 0), ==, 1);
+}
+
+static void
+test_offline_sip_skipped (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_SIP, "sip", "sip", FALSE),
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 1);
+}
+
+static void
+test_sip_only_unchanged (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_SIP, "home", "home", TRUE),
+    cand (CALLS_ORIGIN_KIND_SIP, "work", "work", FALSE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 0);
+}
+
+static void
+test_name_is_not_enough_for_mm (void)
+{
+  /* A non-oFono origin that happens to be labelled imsd is not preferred. */
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "imsd", "imsd", TRUE),
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), TRUE), ==, 0);
+}
+
+static void
+test_ussd_does_not_prefer_imsd (void)
+{
+  CallsOriginCandidate c[] = {
+    cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+    cand (CALLS_ORIGIN_KIND_OFONO, "imsd", "/imsd", TRUE),
+  };
+
+  g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c), FALSE), ==, 0);
+}
+
+static void
+test_common_emergency_does_not_prefer_imsd (void)
+{
+  g_assert_true (calls_number_is_common_emergency ("112"));
+  g_assert_true (calls_number_is_common_emergency ("911"));
+  g_assert_true (calls_number_is_common_emergency ("999"));
+  g_assert_true (calls_number_is_common_emergency ("000"));
+  g_assert_false (calls_number_is_common_emergency ("1120"));
+  g_assert_false (calls_number_is_common_emergency ("*#100#"));
+  g_assert_false (calls_number_is_common_emergency (NULL));
+
+  /* Nobody advertised 112: stay on the first usable origin (MM). */
+  {
+    CallsOriginCandidate c[] = {
+      cand (CALLS_ORIGIN_KIND_MM, "0", "0", TRUE),
+      cand (CALLS_ORIGIN_KIND_OFONO, "imsd", "/imsd", TRUE),
+    };
+
+    g_assert_cmpint (calls_pick_tel_default_origin (c, G_N_ELEMENTS (c),
+                                                    !calls_number_is_common_emergency ("112")),
+                     ==, 0);
+  }
+}
+
+static void
+test_emergency_stays_on_first_listing (void)
+{
+  const char *mm[] = { "112", "911", NULL };
+  const char *imsd[] = { "112", NULL };
+  const char * const *lists[] = { mm, imsd };
+
+  g_assert_cmpint (calls_pick_first_listed ("112", lists, G_N_ELEMENTS (lists)), ==, 0);
+  g_assert_cmpint (calls_pick_first_listed ("113", lists, G_N_ELEMENTS (lists)), ==, -1);
+  g_assert_cmpint (calls_pick_first_listed ("112", NULL, 0), ==, -1);
+
+  /* Only imsd lists it: that origin is used. */
+  {
+    const char *none[] = { "911", NULL };
+    const char * const *only_imsd[] = { none, imsd };
+    g_assert_cmpint (calls_pick_first_listed ("112", only_imsd, 2), ==, 1);
+  }
+}
+
+static void
+test_late_ofono_readd_appears_in_list (void)
+{
+  g_autoptr (GHashTable) modems = NULL;
+  g_autoptr (GListStore) origins = NULL;
+  g_autoptr (GObject) marker = NULL;
+
+  modems = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  origins = g_list_store_new (G_TYPE_OBJECT);
+  marker = g_object_new (G_TYPE_OBJECT, NULL);
+
+  g_assert_true (calls_ofono_modem_should_add (FALSE, FALSE));
+  g_hash_table_insert (modems, g_strdup ("/imsd"), g_object_ref (marker));
+  g_list_store_append (origins, marker);
+  g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (origins)), ==, 1);
+  g_assert_false (calls_ofono_modem_should_add (TRUE, TRUE));
+
+  /* Vanish must drop the proxy and the origin together. */
+  calls_ofono_clear_on_vanish (modems, origins);
+  g_assert_cmpuint (g_hash_table_size (modems), ==, 0);
+  g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (origins)), ==, 0);
+  g_assert_true (calls_ofono_modem_should_add (FALSE, FALSE));
+
+  g_hash_table_insert (modems, g_strdup ("/imsd"), g_object_ref (marker));
+  g_list_store_append (origins, marker);
+  g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (origins)), ==, 1);
+  {
+    g_autoptr (GObject) got = g_list_model_get_item (G_LIST_MODEL (origins), 0);
+    g_assert_true (got == marker);
+  }
+
+  /* Hash left behind, origin already gone: still add. */
+  g_list_store_remove_all (origins);
+  g_assert_true (calls_ofono_modem_should_add (TRUE, FALSE));
+  g_list_store_append (origins, marker);
+  g_assert_cmpuint (g_list_model_get_n_items (G_LIST_MODEL (origins)), ==, 1);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/default-origin/imsd-online-beats-mm", test_imsd_online_beats_mm);
+  g_test_add_func ("/default-origin/imsd-path-id", test_imsd_path_id);
+  g_test_add_func ("/default-origin/imsd-absent-uses-mm", test_imsd_absent_uses_mm);
+  g_test_add_func ("/default-origin/imsd-offline-uses-mm", test_imsd_offline_uses_mm);
+  g_test_add_func ("/default-origin/imsd-not-in-list-uses-mm", test_imsd_not_in_list_uses_mm);
+  g_test_add_func ("/default-origin/explicit-unchanged", test_explicit_origin_unchanged);
+  g_test_add_func ("/default-origin/offline-sip-skipped", test_offline_sip_skipped);
+  g_test_add_func ("/default-origin/sip-only-unchanged", test_sip_only_unchanged);
+  g_test_add_func ("/default-origin/mm-named-imsd-not-preferred", test_name_is_not_enough_for_mm);
+  g_test_add_func ("/default-origin/ussd-does-not-prefer-imsd", test_ussd_does_not_prefer_imsd);
+  g_test_add_func ("/default-origin/common-emergency-stays-on-mm", test_common_emergency_does_not_prefer_imsd);
+  g_test_add_func ("/default-origin/emergency-stays-on-first-listing", test_emergency_stays_on_first_listing);
+  g_test_add_func ("/default-origin/late-ofono-readd", test_late_ofono_readd_appears_in_list);
+
+  return g_test_run ();
+}
