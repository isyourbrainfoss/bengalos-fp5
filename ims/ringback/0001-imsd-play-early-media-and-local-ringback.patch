+    // Local ringback when the network is alerting and is not sending media.
+    // Norway / ETSI: 425 Hz, 1 s on, 4 s off. A short fade keeps the burst
+    // from clicking into the silence. The shell writes these samples to the
+    // earpiece; the engine only decides when.
+    inline constexpr int RingbackRate = 8000;
+    inline constexpr int RingbackHz = 425;
+    inline constexpr int RingbackOnSamples = RingbackRate;
+    inline constexpr int RingbackPeriodSamples = RingbackRate * 5;
+    inline constexpr int RingbackFade = 40;
+    inline constexpr int RingbackAmplitude = 8000;
+
+    inline std::int16_t RingbackSample(std::uint64_t n) {
+        const std::uint64_t pos = n % static_cast<std::uint64_t>(RingbackPeriodSamples);
+        if (pos >= static_cast<std::uint64_t>(RingbackOnSamples)) return 0;
+        double env = 1.0;
+        if (pos < static_cast<std::uint64_t>(RingbackFade))
+            env = static_cast<double>(pos) / static_cast<double>(RingbackFade);
+        else if (pos + static_cast<std::uint64_t>(RingbackFade) >= static_cast<std::uint64_t>(RingbackOnSamples))
+            env = static_cast<double>(RingbackOnSamples - 1 - pos) / static_cast<double>(RingbackFade);
+        const double x = std::sin(2.0 * std::numbers::pi * static_cast<double>(RingbackHz) * static_cast<double>(n) / static_cast<double>(RingbackRate));
+        return static_cast<std::int16_t>(std::lround(env * x * static_cast<double>(RingbackAmplitude)));
+    }
+
     // ring/answer budget, and how long to wait for a 487 after CANCEL — the
