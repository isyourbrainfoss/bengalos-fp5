+    // Local ringback into the same PipeWire session imsd-media plays to.
+    // One process group: the writer and pw-play. SIGTERM to the group
+    // stops both. 20 ms frames at 8 kHz, paced, so the pipe does not
+    // fill ahead of the earpiece.
+    void StartRingback() {
+        if (ringbackPid_ > 0) return;
+        AudioSession session;
+        if (geteuid() == 0) session = ResolveAudioSession();
+        // Built before the fork. The writer never execs, so it must not
+        // allocate, and the play child only execs this argv.
+        std::vector<std::string> argv;
+        if (geteuid() == 0 && !session.name.empty()) {
+            argv = {"sudo", "-u", session.name, "env",
+                    std::format("XDG_RUNTIME_DIR=/run/user/{}", session.uid)};
+        }
+        for (const char* a : {"pw-play", "--raw", "--rate", "8000", "--channels", "1", "--format", "s16", "--latency", "40ms", "-"})
+            argv.emplace_back(a);
+        int fds[2];
+        if (pipe(fds) != 0) {
+            Log(std::format("local ringback: pipe: {}", std::strerror(errno)));
+            return;
+        }
+        pid_t pid = fork();
+        if (pid < 0) {
+            close(fds[0]);
+            close(fds[1]);
+            Log(std::format("local ringback: fork: {}", std::strerror(errno)));
+            return;
+        }
+        if (pid == 0) {
+            // The engine thread's parent has GLib's SIGTERM handler. This
+            // process does not exec, so put the defaults back or the tone
+            // survives the first stop and only SIGKILL ends it.
+            signal(SIGTERM, SIG_DFL);
+            signal(SIGINT, SIG_DFL);
+            signal(SIGHUP, SIG_DFL);
+            signal(SIGPIPE, SIG_IGN);
+            sigset_t empty;
+            sigemptyset(&empty);
+            sigprocmask(SIG_SETMASK, &empty, nullptr);
+            setpgid(0, 0);
+            pid_t play = fork();
+            if (play == 0) {
+                dup2(fds[0], STDIN_FILENO);
+                close(fds[0]);
+                close(fds[1]);
+                std::vector<char*> cargv;
+                for (auto& s : argv) cargv.push_back(const_cast<char*>(s.c_str()));
+                cargv.push_back(nullptr);
+                execvp(cargv[0], cargv.data());
+                _exit(127);
+            }
+            close(fds[0]);
+            if (play < 0) _exit(127);
+            std::uint64_t n = 0;
+            std::int16_t frame[160];
+            auto next = std::chrono::steady_clock::now();
+            for (;;) {
+                for (int i = 0; i < 160; i++)
+                    frame[i] = imsd::engine::RingbackSample(n++);
+                const char* p = reinterpret_cast<const char*>(frame);
+                std::size_t off = 0;
+                while (off < sizeof frame) {
+                    ssize_t w = write(fds[1], p + off, sizeof frame - off);
+                    if (w < 0 && errno == EINTR) continue;
+                    if (w <= 0) _exit(0);
+                    off += static_cast<std::size_t>(w);
+                }
+                next += std::chrono::milliseconds(20);
+                std::this_thread::sleep_until(next);
+            }
+        }
+        setpgid(pid, pid);
+        close(fds[0]);
+        close(fds[1]);
+        ringbackPid_ = pid;
+        Log("local ringback: 425 Hz, 1s on, 4s off");
+    }
+
+    void StopRingback() {
+        if (ringbackPid_ <= 0) return;
+        kill(-ringbackPid_, SIGTERM);
+        kill(ringbackPid_, SIGTERM);
+        for (int i = 0; i < 50; i++) {
+            if (waitpid(ringbackPid_, nullptr, WNOHANG) != 0) { ringbackPid_ = -1; return; }
+            usleep(20000);
+        }
+        kill(-ringbackPid_, SIGKILL);
+        kill(ringbackPid_, SIGKILL);
+        waitpid(ringbackPid_, nullptr, 0);
+        ringbackPid_ = -1;
+    }
+
+    void ReapRingback() {
+        if (ringbackPid_ <= 0) return;
+        int status = 0;
+        pid_t r = waitpid(ringbackPid_, &status, WNOHANG);
+        if (r == 0) return;
+        kill(-ringbackPid_, SIGTERM);
+        ringbackPid_ = -1;
+        Log("local ringback ended");
+    }
+
     void StopMedia() {
         CloseMediaCtl();
         if (mediaPid_ <= 0) return;
@@ -2650,13 +2769,18 @@ private:
 
     void ReapMedia() {
         if (!call_ || mediaPid_ <= 0) return;
-        if (call_->State() != imsd::engine::CallState::Active) return;
         int status = 0;
         pid_t r = waitpid(mediaPid_, &status, WNOHANG);
         if (r == 0) return;  // still running
         int code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
         mediaPid_ = -1;  // reaped; don't re-terminate
         CloseMediaCtl();
+        // An early-media leg can exit before the answer (no RTP yet).
+        // The engine falls back to local ringback and does not BYE.
+        if (call_->State() != imsd::engine::CallState::Active) {
+            Execute(call_->OnMediaExit(code));
+            return;
+        }
         Execute(call_->OnMediaExit(code));
         MaybeDropCall();
     }
