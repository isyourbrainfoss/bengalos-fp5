+        // Whole-word match, ASCII case-insensitive. "sendrecv" does not
+        // count as "sendonly".
+        static bool PemToken(std::string_view value, std::string_view token) {
+            auto lower = [](char c) {
+                return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
+            };
+            auto alpha = [](char c) {
+                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+            };
+            std::size_t at = 0;
+            while (at + token.size() <= value.size()) {
+                bool match = true;
+                for (std::size_t i = 0; i < token.size(); i++) {
+                    if (lower(value[at + i]) != lower(token[i])) { match = false; break; }
+                }
+                const bool left = at == 0 || !alpha(value[at - 1]);
+                const bool right = at + token.size() == value.size() || !alpha(value[at + token.size()]);
+                if (match && left && right) return true;
+                at++;
+            }
+            return false;
+        }
+
+        // True when this 1xx offers backward early media the UE should
+        // render instead of a local tone. P-Early-Media wins when present
+        // (RFC 5009: sendrecv/sendonly from the network). Absent, any
+        // usable SDP is the offer, except a precondition 183.
+        bool BackwardEarly(int code, std::string_view msg) const {
+            if (auto pem = imsd::sip::Header(msg, "P-Early-Media"))
+                return PemToken(*pem, "sendrecv") || PemToken(*pem, "sendonly");
+            if (precond_ && code != 180) return false;
+            return true;
+        }
+
+        // Drop the local tone and a downlink-only early leg. A full-duplex
+        // leg (the answered call) is not marked early and is left to Finish.
+        std::vector<Action> StopAlertAudio() {
+            std::vector<Action> a;
+            if (ringback_) {
+                ringback_ = false;
+                a.push_back(Action{Action::Type::StopRingback});
+            }
+            if (earlyMedia_) {
+                earlyMedia_ = false;
+                a.push_back(Action{Action::Type::StopMedia});
+            }
+            return a;
+        }
+
