From 20c10dd71d1c5652bdabe192747f0a5492d98eda Mon Sep 17 00:00:00 2001
From: box <box@localhost>
Date: Thu, 29 Oct 2026 08:39:44 +0100
Subject: [PATCH 2/4] load-qcomtee: decide by kernel features, not by uname -r

Built-in when /dev/tee0 or the qcomtee driver exists, insmod only when
the bridge module file ($QCOMTEE_BRIDGE_KO) exists, refuse otherwise.
/sys/class/tee alone no longer counts (OPTEE creates it too). Tests updated.
---
 app/test_fp5_qtee_boot.py | 22 ++++++++++++--------
 scripts/load-qcomtee.sh   | 43 ++++++++++++++++++++++-----------------
 2 files changed, 38 insertions(+), 27 deletions(-)

diff --git a/app/test_fp5_qtee_boot.py b/app/test_fp5_qtee_boot.py
index 07fdcb7..162d75a 100644
--- a/app/test_fp5_qtee_boot.py
+++ b/app/test_fp5_qtee_boot.py
@@ -3,6 +3,7 @@
 
 from __future__ import annotations
 
+import os
 import subprocess
 import unittest
 from pathlib import Path
@@ -14,14 +15,16 @@ UNIT = ROOT / "scripts" / "fp5-qtee-load.service"
 
 class BootUnitTest(unittest.TestCase):
     def test_wrong_kernel_exits_before_insmod(self) -> None:
+        env = dict(os.environ, QCOMTEE_BRIDGE_KO="/nonexistent/qcomtee-bridge.ko")
         proc = subprocess.run(
             ["sh", str(SCRIPT)],
             capture_output=True,
             text=True,
             check=False,
+            env=env,
         )
         self.assertEqual(proc.returncode, 1)
-        self.assertIn("kernel ", proc.stdout)
+        self.assertIn("kernel has no qcomtee", proc.stdout)
         self.assertNotIn("INSMOD_OK", proc.stdout + proc.stderr)
         self.assertNotIn("insmod", proc.stdout + proc.stderr)
 
@@ -36,16 +39,19 @@ class BootUnitTest(unittest.TestCase):
             self.assertEqual(proc.returncode, 0, proc.stderr)
             return proc.stdout.strip()
 
-        # rel fingerpr module tee0 driver class
-        self.assertEqual(plan("7.2.0-nfc-test+", "0", "0", "0", "0", "1"), "insmod")
-        self.assertEqual(plan("7.2.9", "0", "0", "1", "1", "1"), "builtin")
-        self.assertEqual(plan("7.2.9", "1", "0", "1", "1", "1"), "refuse-fingerpr")
-        self.assertEqual(plan("7.2.9", "0", "1", "1", "1", "1"), "already")
-        self.assertEqual(plan("7.2.10", "0", "0", "0", "0", "0"), "refuse-kernel")
+        # bridge_ko fingerpr module tee0 driver class
+        self.assertEqual(plan("1", "0", "0", "0", "0", "1"), "insmod")
+        self.assertEqual(plan("0", "0", "0", "1", "1", "1"), "builtin")
+        self.assertEqual(plan("0", "0", "0", "0", "1", "1"), "builtin")
+        self.assertEqual(plan("1", "1", "0", "1", "1", "1"), "refuse-fingerpr")
+        self.assertEqual(plan("0", "0", "1", "1", "1", "1"), "already")
+        # OPTEE's /sys/class/tee without qcomtee is not enough
+        self.assertEqual(plan("0", "0", "0", "0", "0", "1"), "refuse-kernel")
+        self.assertEqual(plan("0", "0", "0", "0", "0", "0"), "refuse-kernel")
 
     def test_script_still_refuses_the_old_driver(self) -> None:
         text = SCRIPT.read_text(encoding="utf-8")
-        self.assertIn("7.2.0-nfc-test+", text)
+        self.assertNotIn("uname", text)
         self.assertIn("qsee_fingerpr is loaded", text)
         self.assertIn("qcomtee already loaded", text)
         self.assertIn("qcomtee built-in", text)
diff --git a/scripts/load-qcomtee.sh b/scripts/load-qcomtee.sh
index b4b32e2..1fb92fa 100755
--- a/scripts/load-qcomtee.sh
+++ b/scripts/load-qcomtee.sh
@@ -1,18 +1,23 @@
 #!/bin/sh
-# Load the out-of-tree qcomtee module, or accept a built-in one.
-# The .ko is not in this repo.
-# Refuses qsee_fingerpr. No-op if qcomtee is already loaded or built in.
-# 7.2.0-nfc-test+ still insmods qcomtee-bridge.ko. A kernel that already
-# has /dev/tee0 or the qcomtee driver (7.2.9, CONFIG_QCOMTEE=y,
-# CONFIG_QCOM_TZMEM_MODE_GENERIC=y) does not.
+# Make sure the fingerprint reader has a QTEE device (/dev/tee0).
+# Decides by what the kernel offers, never by the kernel version:
+#  - qsee_fingerpr loaded            -> refuse (never load both)
+#  - qcomtee module already loaded   -> nothing to do
+#  - /dev/tee0 or the qcomtee driver -> built in (CONFIG_QCOMTEE=y), nothing to do
+#  - else, if the out-of-tree bridge module exists ($QCOMTEE_BRIDGE_KO,
+#    default /home/user/fp5-qtee-keep/qcomtee-bridge.ko) -> insmod it
+#  - else refuse.
+# BengalOS test kernel: CONFIG_QCOMTEE=y, so this only ever says "built-in".
 # A root caller (the boot unit) runs the commands directly. Everyone
-# else still uses sudo -n.
+# else still uses sudo -n (Nura only; BengalOS has no sudo).
 set -e
 
-# qcomtee_plan REL FINGERPR MODULE TEE0 DRIVER CLASS
+# qcomtee_plan BRIDGE_KO FINGERPR MODULE TEE0 DRIVER CLASS
+# BRIDGE_KO is 1 when the out-of-tree bridge module file exists.
+# CLASS (/sys/class/tee) alone is not enough: OPTEE also creates it.
 # Prints refuse-fingerpr, already, builtin, insmod, or refuse-kernel.
 qcomtee_plan() {
-	rel=$1
+	ko=$1
 	fingerpr=$2
 	mod=$3
 	tee0=$4
@@ -31,16 +36,11 @@ qcomtee_plan() {
 		echo builtin
 		return 0
 	fi
-	# 7.2.0-nfc-test+ has CONFIG_OPTEE, so /sys/class/tee exists with no
-	# qcomtee. That kernel still needs the out-of-tree module.
-	if [ "$rel" = "7.2.0-nfc-test+" ]; then
+	if [ "$ko" = 1 ]; then
 		echo insmod
 		return 0
 	fi
-	if [ "$class" = 1 ]; then
-		echo builtin
-		return 0
-	fi
+	: "$class"
 	echo refuse-kernel
 	return 0
 }
@@ -50,6 +50,11 @@ if [ "${1:-}" = "--plan" ]; then
 	exit 0
 fi
 
+BRIDGE_KO=${QCOMTEE_BRIDGE_KO:-/home/user/fp5-qtee-keep/qcomtee-bridge.ko}
+ko=0
+if [ -f "$BRIDGE_KO" ]; then
+	ko=1
+fi
 fingerpr=0
 mod=0
 tee0=0
@@ -71,7 +76,7 @@ if [ -d /sys/class/tee ]; then
 	class=1
 fi
 
-plan=$(qcomtee_plan "$(uname -r)" "$fingerpr" "$mod" "$tee0" "$drv" "$class")
+plan=$(qcomtee_plan "$ko" "$fingerpr" "$mod" "$tee0" "$drv" "$class")
 case "$plan" in
 refuse-fingerpr)
 	echo "qsee_fingerpr is loaded"
@@ -86,7 +91,7 @@ builtin)
 	exit 0
 	;;
 refuse-kernel)
-	echo "kernel $(uname -r)"
+	echo "kernel has no qcomtee (no /dev/tee0, no qcomtee driver) and no $BRIDGE_KO"
 	exit 1
 	;;
 insmod)
@@ -104,5 +109,5 @@ else
 fi
 SCM=$(run awk "\$3==\"__scm_smc_call\" {print \$1}" /proc/kallsyms)
 CONV=$(run awk "\$3==\"qcom_scm_convention\" {print \$1}" /proc/kallsyms)
-run insmod /home/user/fp5-qtee-keep/qcomtee-bridge.ko scm_call_addr=0x$SCM scm_conv_addr=0x$CONV
+run insmod "$BRIDGE_KO" scm_call_addr=0x$SCM scm_conv_addr=0x$CONV
 echo INSMOD_OK
-- 
