+# Install the system-service layout (BengalOS: no sudo, read-only /usr).
+# make -C session && make -C service install DESTDIR=...
+PREFIX ?= /usr
+LIBEXECDIR ?= $(PREFIX)/libexec/fp5-qtee
+DATADIR ?= $(PREFIX)/share/fp5-qtee
+UNITDIR ?= $(PREFIX)/lib/systemd/system
+USERUNITDIR ?= $(PREFIX)/lib/systemd/user
+POLKITDIR ?= $(PREFIX)/share/polkit-1/actions
+DOCDIR ?= $(PREFIX)/share/doc/fp5-qtee
+APP = ../app
+PY = fp5_qtee_unlock.py fp5_qtee_transport.py fp5_qtee_haptic.py fp5_qtee_coach.py fp5-qtee-app.py
+
+.PHONY: install
+install:
+	$(MAKE) -C ../session install DESTDIR=$(DESTDIR) PREFIX=$(PREFIX) LIBEXECDIR=$(LIBEXECDIR)
+	install -Dm755 fp5-qtee-broker $(DESTDIR)$(LIBEXECDIR)/fp5-qtee-broker
+	install -Dm644 fp5-qtee.socket $(DESTDIR)$(UNITDIR)/fp5-qtee.socket
+	install -Dm644 fp5-qtee-session@.service $(DESTDIR)$(UNITDIR)/fp5-qtee-session@.service
+	install -Dm644 fp5-qtee-unlock.service $(DESTDIR)$(USERUNITDIR)/fp5-qtee-unlock.service
+	install -Dm644 org.fp5.qtee.policy $(DESTDIR)$(POLKITDIR)/org.fp5.qtee.policy
+	install -Dm644 org.fp5.qtee.desktop $(DESTDIR)$(PREFIX)/share/applications/org.fp5.qtee.desktop
+	install -Dm644 $(APP)/fp5-qtee-feedback.json $(DESTDIR)$(DATADIR)/fp5-qtee-feedback.json
+	for f in $(PY); do install -Dm644 $(APP)/$$f $(DESTDIR)$(DATADIR)/$$f; done
+	install -Dm644 ../docs/bengalos-mbn.md $(DESTDIR)$(DOCDIR)/bengalos-mbn.md
+	install -Dm644 99-fp5-qtee.preset $(DESTDIR)$(PREFIX)/lib/systemd/system-preset/99-fp5-qtee.preset
+	install -Dm644 99-fp5-qtee-user.preset $(DESTDIR)$(PREFIX)/lib/systemd/user-preset/99-fp5-qtee.preset
diff --git a/service/fp5-qtee-broker b/service/fp5-qtee-broker
new file mode 100755
index 0000000..51f67ef
--- /dev/null
+++ b/service/fp5-qtee-broker
@@ -0,0 +1,117 @@
+#!/usr/bin/python3
+"""fp5-qtee-broker: the system side of the fp5-qtee socket (no sudo).
+
+Started by fp5-qtee-session@.service, one instance per connection, with
+the accepted socket as stdin/stdout. It:
+
+1. reads exactly one line "MODE <mode> [args...]" (byte by byte, so no
+   later protocol bytes are swallowed);
+2. finds the caller with SO_PEERCRED;
+3. asks polkit (pkcheck) whether that process may run the mode;
+4. execs the session binary with the socket still on stdin/stdout.
+
+Modes and polkit actions:
+  serve, unlock          org.fp5.qtee.unlock   (active session: yes)
+  list                   org.fp5.qtee.list     (active session: yes)
+  enroll, remove         org.fp5.qtee.manage   (auth_admin_keep)
+Anything else (probe, bench, ...) is refused: those are developer modes
+and stay a root-shell thing.
+"""
+
+import os
+import re
+import socket
+import struct
+import subprocess
+import sys
+
+SESSION = os.environ.get("FP5_QTEE_SESSION", "/usr/libexec/fp5-qtee/fp5-qtee-session")
+FW_DIR = os.environ.get("FP5_QTEE_FW_DIR", "/var/lib/firmware/qsee")
+ACTIONS = {
+    "serve": "org.fp5.qtee.unlock",
+    "unlock": "org.fp5.qtee.unlock",
+    "list": "org.fp5.qtee.list",
+    "enroll": "org.fp5.qtee.manage",
+    "remove": "org.fp5.qtee.manage",
+}
+ARG_RE = re.compile(r"^[0-9A-Za-z_.-]{1,32}$")
+MAX_ARGS = {"remove": 4}
+MAX_LINE = 256
+
+
+def say(msg: str) -> None:
+    try:
+        os.write(1, (msg + "\n").encode())
+    except OSError:
+        pass
+    print(msg, file=sys.stderr, flush=True)
+
+
+def read_line(fd: int) -> str:
+    buf = bytearray()
+    while len(buf) < MAX_LINE:
+        b = os.read(fd, 1)
+        if not b:
+            break
+        if b == b"\n":
+            return buf.decode("ascii", "strict")
+        buf += b
+    raise ValueError("no MODE line")
+
+
+def peer(sock: socket.socket) -> tuple[int, int, int]:
+    data = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
+    return struct.unpack("3i", data)
+
+
+def start_time(pid: int) -> str:
+    with open(f"/proc/{pid}/stat") as f:
+        stat = f.read()
+    # Field 22, counted after the ")" that ends the comm field.
+    return stat.rsplit(")", 1)[1].split()[19]
+
+
+def allowed(action: str, pid: int, uid: int) -> bool:
+    if uid == 0:
+        return True
+    subject = f"{pid},{start_time(pid)},{uid}"
+    res = subprocess.run(
+        ["pkcheck", "--action-id", action, "--process", subject,
+         "--allow-user-interaction"],
+        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL, timeout=120,
+    )
+    return res.returncode == 0
+
+
+def main() -> int:
+    sock = socket.socket(fileno=os.dup(0))
+    try:
+        pid, uid, _gid = peer(sock)
+        words = read_line(0).split()
+    except (OSError, ValueError, UnicodeDecodeError) as exc:
+        say(f"BROKER refused: {exc}")
+        return 2
+    if len(words) < 2 or words[0] != "MODE" or words[1] not in ACTIONS:
+        say("BROKER refused: unknown mode")
+        return 2
+    mode, args = words[1], words[2:]
+    if len(args) > MAX_ARGS.get(mode, 0) or not all(ARG_RE.match(a) for a in args):
+        say("BROKER refused: bad arguments")
+        return 2
+    try:
+        ok = allowed(ACTIONS[mode], pid, uid)
+    except (OSError, subprocess.SubprocessError) as exc:
+        say(f"BROKER refused: polkit check failed: {exc}")
+        return 3
+    if not ok:
+        say(f"BROKER refused: not authorized for {ACTIONS[mode]}")
+        return 3
+    print(f"fp5-qtee: uid {uid} pid {pid} mode {mode}", file=sys.stderr, flush=True)
+    sock.close()
+    os.execv(SESSION, [SESSION, mode, FW_DIR, *args])
+    return 127
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/service/fp5-qtee-session@.service b/service/fp5-qtee-session@.service
new file mode 100644
index 0000000..0bd2a66
--- /dev/null
+++ b/service/fp5-qtee-session@.service
@@ -0,0 +1,32 @@
+[Unit]
+Description=FP5 fingerprint (QTEE) session for one client
+Documentation=file:///usr/share/doc/fp5-qtee/bengalos-mbn.md
+After=mnt-persist.mount
+Wants=mnt-persist.mount
+
+[Service]
+Type=simple
+ExecStart=/usr/libexec/fp5-qtee/fp5-qtee-broker
+StandardInput=socket
+StandardOutput=socket
+StandardError=journal
+Environment=FP5_QTEE_FW_DIR=/var/lib/firmware/qsee
+# BengalOS mounts persist itself (mnt-persist.mount, read-only for now).
+Environment=FP5_QTEE_MOUNT_PERSIST=0
+# Root is needed for /dev/tee0, the RPMB SG_IO path and the GP files on
+# /mnt/persist. Keep the rest small.
+User=root
+NoNewPrivileges=yes
+ProtectHome=yes
+PrivateTmp=yes
+ProtectSystem=strict
+ReadWritePaths=-/mnt/persist
+ProtectKernelTunables=yes
+ProtectControlGroups=yes
+RestrictAddressFamilies=AF_UNIX AF_NETLINK
+RestrictRealtime=no
+LockPersonality=yes
+MemoryDenyWriteExecute=yes
+SystemCallArchitectures=native
+# Hard cap; enroll is the longest mode (about 25 min with coaching).
+RuntimeMaxSec=1800
