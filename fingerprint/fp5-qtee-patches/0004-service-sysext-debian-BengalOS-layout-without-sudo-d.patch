+# User unit: the lock-screen watcher. It talks to the system socket, so it
+# needs no sudo and no root.
+[Unit]
+Description=FP5 fingerprint unlock watcher
+PartOf=graphical-session.target
+After=graphical-session.target
+ConditionPathExists=/run/fp5-qtee/session.sock
+
+[Service]
+Type=simple
+Environment=FP5_QTEE_TRANSPORT=socket
+Environment=PYTHONPATH=/usr/share/fp5-qtee
+ExecStart=/usr/bin/python3 /usr/share/fp5-qtee/fp5_qtee_unlock.py
+Restart=on-failure
+RestartSec=5
+
+[Install]
+WantedBy=graphical-session.target
diff --git a/service/fp5-qtee.socket b/service/fp5-qtee.socket
new file mode 100644
index 0000000..cf5a67f
--- /dev/null
+++ b/service/fp5-qtee.socket
@@ -0,0 +1,17 @@
+[Unit]
+Description=FP5 fingerprint (QTEE) session socket
+Documentation=file:///usr/share/doc/fp5-qtee/bengalos-mbn.md
+# Only when the kernel has the TEE and the sensor driver.
+ConditionPathExists=/dev/tee0
+
+[Socket]
+ListenStream=/run/fp5-qtee/session.sock
+SocketMode=0666
+DirectoryMode=0755
+Accept=yes
+# One trustlet session at a time: the sensor and the TA are single-user.
+MaxConnections=1
+RemoveOnStop=yes
+
+[Install]
+WantedBy=sockets.target
