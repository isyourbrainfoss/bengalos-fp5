diff --git a/session/fp5_fw.c b/session/fp5_fw.c
new file mode 100644
index 0000000..5addfb6
--- /dev/null
+++ b/session/fp5_fw.c
@@ -0,0 +1,149 @@
+/*
+ * Trustlet file loading: a prebuilt .mbn first, the split .mdt/.bNN second.
+ */
+#include "fp5_fw.h"
+#include "fp5_image.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define FP5_FW_MAX_FILE (64u << 20)
+
+static int slurp(const char *path, uint8_t **out, size_t *len)
+{
+	struct stat st;
+	uint8_t *buf;
+	size_t got = 0;
+	int fd;
+
+	*out = NULL;
+	*len = 0;
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 ||
+	    (unsigned long long)st.st_size > FP5_FW_MAX_FILE) {
+		close(fd);
+		return -EINVAL;
+	}
+	buf = malloc((size_t)st.st_size);
+	if (!buf) {
+		close(fd);
+		return -ENOMEM;
+	}
+	while (got < (size_t)st.st_size) {
+		ssize_t n = read(fd, buf + got, (size_t)st.st_size - got);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0) {
+			free(buf);
+			close(fd);
+			return n < 0 ? -errno : -EIO;
+		}
+		got += (size_t)n;
+	}
+	close(fd);
+	*out = buf;
+	*len = got;
+	return 0;
+}
+
+int fp5_fw_is_elf(const uint8_t *buf, size_t len)
+{
+	return buf && len >= 52 && buf[0] == 0x7f && buf[1] == 'E' &&
+	       buf[2] == 'L' && buf[3] == 'F';
+}
+
+const char *fp5_fw_dir(const char *arg)
+{
+	const char *env = getenv("FP5_QTEE_FW_DIR");
+
+	if (env && *env)
+		return env;
+	if (arg && *arg)
+		return arg;
+	return FP5_FW_DEFAULT_DIR;
+}
+
+int fp5_fw_load_split(const char *dir, const char *name, uint8_t **out,
+		      size_t *out_len)
+{
+	char path[512];
+	uint8_t *mdt = NULL, *raw[FP5_FW_MAX_SEGS] = { 0 };
+	struct fp5_seg segs[FP5_FW_MAX_SEGS];
+	size_t mdt_len = 0;
+	size_t n = 0;
+	int rc, i;
+
+	snprintf(path, sizeof(path), "%s/%s.mdt", dir, name);
+	rc = slurp(path, &mdt, &mdt_len);
+	if (rc)
+		return rc;
+	for (i = 0; i < FP5_FW_MAX_SEGS; i++) {
+		size_t len = 0;
+
+		snprintf(path, sizeof(path), "%s/%s.b%02d", dir, name, i);
+		if (access(path, F_OK))
+			break;
+		rc = slurp(path, &raw[i], &len);
+		if (rc)
+			goto out;
+		segs[i].data = raw[i];
+		segs[i].len = len;
+		n++;
+	}
+	rc = n ? fp5_mbn_from_mdt(mdt, mdt_len, segs, n, out, out_len)
+	       : -ENOENT;
+out:
+	free(mdt);
+	for (i = 0; i < FP5_FW_MAX_SEGS; i++)
+		free(raw[i]);
+	return rc;
+}
+
+static int load_from(const char *dir, const char *name, uint8_t **out,
+		     size_t *out_len, char *used, size_t used_len)
+{
+	char path[512];
+	int rc;
+
+	snprintf(path, sizeof(path), "%s/%s.mbn", dir, name);
+	rc = slurp(path, out, out_len);
+	if (rc == 0) {
+		if (fp5_fw_is_elf(*out, *out_len)) {
+			if (used)
+				snprintf(used, used_len, "%s", path);
+			return 0;
+		}
+		free(*out);
+		*out = NULL;
+		*out_len = 0;
+		rc = -EINVAL;	/* not an ELF: try the split files */
+	}
+	rc = fp5_fw_load_split(dir, name, out, out_len);
+	if (rc == 0 && used)
+		snprintf(used, used_len, "%s/%s.mdt", dir, name);
+	return rc;
+}
+
+int fp5_fw_load(const char *dir, const char *name, uint8_t **out,
+		size_t *out_len, char *used, size_t used_len)
+{
+	int rc;
+
+	*out = NULL;
+	*out_len = 0;
+	if (!dir || !name || !*name || strchr(name, '/'))
+		return -EINVAL;
+	rc = load_from(dir, name, out, out_len, used, used_len);
+	if (rc && !strcmp(dir, FP5_FW_DEFAULT_DIR))
+		rc = load_from(FP5_FW_LEGACY_DIR, name, out, out_len, used,
+			       used_len);
+	return rc;
+}
diff --git a/session/fp5_fw.h b/session/fp5_fw.h
new file mode 100644
index 0000000..37008f1
--- /dev/null
+++ b/session/fp5_fw.h
@@ -0,0 +1,37 @@
+#ifndef FP5_FW_H
+#define FP5_FW_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Default trustlet directory: droid-juicer (BengalOS) writes here. */
+#define FP5_FW_DEFAULT_DIR "/var/lib/firmware/qsee"
+/* Old location (Nura, hand-copied split files). Tried after the default. */
+#define FP5_FW_LEGACY_DIR "/lib/firmware/qsee"
+#define FP5_FW_MAX_SEGS 16
+
+/*
+ * Directory to load from: $FP5_QTEE_FW_DIR if set and non-empty, else
+ * arg if non-NULL and non-empty, else FP5_FW_DEFAULT_DIR.
+ */
+const char *fp5_fw_dir(const char *arg);
+
+/*
+ * Load trustlet <name> as one ELF image.
+ * Order: <dir>/<name>.mbn (prebuilt, e.g. squashed by droid-juicer), then
+ * <dir>/<name>.mdt + .b00.. (assembled in memory). When dir is the default
+ * and neither is there, FP5_FW_LEGACY_DIR is tried the same way.
+ * On success returns 0, a malloc'd image in *out, and the path used in
+ * used (if used != NULL, at most used_len bytes). Negative on failure.
+ */
+int fp5_fw_load(const char *dir, const char *name, uint8_t **out,
+		size_t *out_len, char *used, size_t used_len);
+
+/* Only the split files: <dir>/<name>.mdt + .b00.. (no .mbn, no fallback). */
+int fp5_fw_load_split(const char *dir, const char *name, uint8_t **out,
+		      size_t *out_len);
+
+/* 1 if buf looks like an ELF image (magic only). */
+int fp5_fw_is_elf(const uint8_t *buf, size_t len);
+
+#endif
diff --git a/session/test_fp5_fw.c b/session/test_fp5_fw.c
new file mode 100644
index 0000000..ba63fc2
--- /dev/null
+++ b/session/test_fp5_fw.c
@@ -0,0 +1,96 @@
+#include "fp5_fw.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static void fail(const char *msg)
+{
+	fprintf(stderr, "FAIL %s\n", msg);
+	exit(1);
+}
+
+static void put(const char *dir, const char *file, const void *b, size_t n)
+{
+	char p[512];
+	FILE *f;
+
+	snprintf(p, sizeof(p), "%s/%s", dir, file);
+	f = fopen(p, "wb");
+	if (!f || fwrite(b, 1, n, f) != n)
+		fail("write fixture");
+	fclose(f);
+}
+
+/* Same ELF32 layout as test_fp5_image.c: two segments, a gap between. */
+static void split_fixture(const char *dir, uint8_t *mdt)
+{
+	uint8_t s0[4] = { 0x11, 0x22, 0x33, 0x44 };
+	uint8_t s1[4] = { 0xaa, 0xbb, 0xcc, 0xdd };
+
+	memset(mdt, 0, 128);
+	mdt[0] = 0x7f; mdt[1] = 'E'; mdt[2] = 'L'; mdt[3] = 'F';
+	mdt[4] = 1; mdt[5] = 1;
+	mdt[28] = 52; mdt[42] = 32; mdt[44] = 2;
+	mdt[52 + 4] = 4; mdt[52 + 16] = 4;
+	mdt[84 + 4] = 64; mdt[84 + 16] = 4;
+	put(dir, "t.mdt", mdt, 128);
+	put(dir, "t.b00", s0, 4);
+	put(dir, "t.b01", s1, 4);
+}
+
+int main(void)
+{
+	char tmpl[] = "/tmp/fp5fwXXXXXX";
+	char *dir = mkdtemp(tmpl);
+	uint8_t mdt[128], *img = NULL, *img2 = NULL;
+	size_t len = 0, len2 = 0;
+	char used[512];
+
+	if (!dir)
+		fail("mkdtemp");
+	unsetenv("FP5_QTEE_FW_DIR");
+	if (strcmp(fp5_fw_dir(NULL), FP5_FW_DEFAULT_DIR))
+		fail("default dir");
+	if (strcmp(fp5_fw_dir("/x"), "/x"))
+		fail("arg dir");
+	setenv("FP5_QTEE_FW_DIR", "/y", 1);
+	if (strcmp(fp5_fw_dir("/x"), "/y"))
+		fail("env dir wins");
+	unsetenv("FP5_QTEE_FW_DIR");
+
+	/* 1. split only: assembled in memory */
+	split_fixture(dir, mdt);
+	if (fp5_fw_load(dir, "t", &img, &len, used, sizeof(used)))
+		fail("split load");
+	if (!strstr(used, "t.mdt") || len < 68 || img[4] != 0x11 ||
+	    img[64] != 0xaa)
+		fail("split content");
+
+	/* 2. a prebuilt .mbn is preferred, byte for byte */
+	img[100] = 0x5a;	/* mark it so we can tell it apart */
+	put(dir, "t.mbn", img, len);
+	if (fp5_fw_load(dir, "t", &img2, &len2, used, sizeof(used)))
+		fail("mbn load");
+	if (!strstr(used, "t.mbn") || len2 != len || memcmp(img, img2, len))
+		fail("mbn content");
+	free(img2);
+
+	/* 3. a .mbn that is not ELF falls back to the split files */
+	put(dir, "t.mbn", "garbage-not-elf-garbage-not-elf-garbage-not-elf-garbage", 56);
+	if (fp5_fw_load(dir, "t", &img2, &len2, used, sizeof(used)) ||
+	    !strstr(used, "t.mdt"))
+		fail("non-elf fallback");
+	free(img2);
+
+	/* 4. nothing there */
+	if (fp5_fw_load(dir, "missing", &img2, &len2, NULL, 0) == 0)
+		fail("missing must fail");
+	if (fp5_fw_load(dir, "../t", &img2, &len2, NULL, 0) == 0)
+		fail("path in name must fail");
+
+	free(img);
+	printf("test_fp5_fw ok\n");
+	return 0;
+}
