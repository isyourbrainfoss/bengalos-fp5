# FP5 carried add-on (fp5-modemmanager), published in fp5-feed from 0.26.1120.1.
# Install into /etc/sysupdate.d/ only now that the feed offers this for the candidate version:
# sysupdate treats a version as incomplete if any transfer lacks it.
[Transfer]
ProtectVersion=%A
Verify=no

[Source]
Type=url-file
Path=https://github.com/isyourbrainfoss/bengalos-fp5/releases/download/fp5-feed/
MatchPattern=fp5-modemmanager_@v.raw.xz

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=fp5-modemmanager_@v.raw
Mode=0444
InstancesMax=2
