# Fairphone 5 safety: make internal UFS storage read-only for the whole BengalOS session.
# BengalOS runs from the microSD and only needs to READ slot-A firmware (droid-juicer)
# and modem EFS (rmtfs runs with -r = read-only on qcom here).
#
# Whole LUNs sdb..sdf (xbl, cdt/ddr, A/B firmware incl. boot/abl/vbmeta + their GPT, modemst/fsg):
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[b-f]", RUN+="/usr/sbin/blockdev --setro $devnode"
# All UFS partitions (userdata, persist, fpconfig_persist, ...) read-only, except "super":
# device-mapper must be able to stack on it; its dm views are set read-only by the
# make-dynpart-mappings@ drop-in right after mapping. (Runs after 60-persistent-storage
# so ID_PART_ENTRY_NAME is known.)
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNEL=="sd[a-f][0-9]*", ENV{ID_PART_ENTRY_NAME}!="super", RUN+="/usr/sbin/blockdev --setro $devnode"
