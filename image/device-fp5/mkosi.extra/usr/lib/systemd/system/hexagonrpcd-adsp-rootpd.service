# Fairphone 5: ADSP root PD instance (Nura runs rootpd + sensorspd; the Debian unit is sensorspd only).
[Unit]
Description=Hexagon DSP root PD daemon (ADSP, FP5)
ConditionPathExists=/var/lib/droid-juicer/sensors/sensors/config
Conflicts=shutdown.target
After=multi-user.target
Before=shutdown.target

[Service]
Type=simple
DevicePolicy=closed
DeviceAllow=/dev/fastrpc-adsp
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
NoNewPrivileges=yes
ExecStart=/usr/libexec/hexagonrpc/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -R /var/lib/droid-juicer/sensors/
User=fastrpc
Group=fastrpc

[Install]
WantedBy=default.target
