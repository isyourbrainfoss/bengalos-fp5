# FP5 override of the official usr transfer. Same Target as upstream.
[Transfer]
ProtectVersion=%A
Verify=no

[Source]
Type=url-file
Path=https://github.com/isyourbrainfoss/bengalos-fp5/releases/download/fp5-feed/
MatchPattern=%M_@v.usr.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=%M-@v
MatchPartitionType=usr
PartitionFlags=0
ReadOnly=1
