diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/make-dynpart-mappings@.service.d/10-fp5-readonly.conf b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/make-dynpart-mappings@.service.d/10-fp5-readonly.conf
new file mode 100644
index 0000000..0bd5bbe
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/make-dynpart-mappings@.service.d/10-fp5-readonly.conf
@@ -0,0 +1,4 @@
+# Fairphone 5: make the device-mapper views of Android dynamic partitions read-only
+# (make-dynpart-mappings opens super O_RDONLY but creates writable dm targets).
+[Service]
+ExecStartPost=/bin/sh -c 'for d in /dev/mapper/*; do [ "$d" = /dev/mapper/control ] && continue; [ -b "$d" ] && /usr/sbin/blockdev --setro "$d"; done; true'
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/mnt-persist.mount b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/mnt-persist.mount
new file mode 100644
index 0000000..d51afef
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/mnt-persist.mount
@@ -0,0 +1,17 @@
+# Fairphone 5: Android "persist" (sensors registry, fingerprint secure storage).
+# READ-ONLY, always. "noload" skips ext4 journal replay, so mounting can never write to it.
+# The block device is also set read-only by 61-bengalos-fp5-ufs-readonly.rules.
+# NEVER change this to rw in this image. A rw persist for fingerprint templates is a later phase.
+[Unit]
+Description=Android persist partition (read-only)
+ConditionPathExists=/dev/disk/by-partlabel/persist
+DefaultDependencies=no
+Conflicts=umount.target
+Before=umount.target
+
+[Mount]
+What=/dev/disk/by-partlabel/persist
+Where=/mnt/persist
+Type=ext4
+Options=ro,noload,nosuid,nodev,noexec,noatime
+DirectoryMode=0755
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/udev/rules.d/61-bengalos-fp5-ufs-readonly.rules b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/udev/rules.d/61-bengalos-fp5-ufs-readonly.rules
new file mode 100644
index 0000000..bd77b61
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/udev/rules.d/61-bengalos-fp5-ufs-readonly.rules
@@ -0,0 +1,7 @@
+# Internal UFS boot. BengalOS lives in the userdata nested GPT, so userdata
+# must stay writable. super stays writable so device-mapper can map it; the
+# dynpart drop-in then sets those mapper devices read-only.
+# Every other UFS disk and partition is read-only (xbl, abl, boot, modem, persist).
+# The microSD draft of this rule also locked userdata. Do not use that draft here.
+ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[b-f]", RUN+="/usr/sbin/blockdev --setro $devnode"
+ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNEL=="sd[a-f][0-9]*", ENV{ID_PART_ENTRY_NAME}!="super", ENV{ID_PART_ENTRY_NAME}!="userdata", RUN+="/usr/sbin/blockdev --setro $devnode"
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/udev/rules.d/81-libssc-fairphone-fp5.rules b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/udev/rules.d/81-libssc-fairphone-fp5.rules
