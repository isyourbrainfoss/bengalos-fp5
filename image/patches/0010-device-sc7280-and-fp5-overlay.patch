diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.conf b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.conf
new file mode 100644
index 0000000..8cf3fe8
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.conf
@@ -0,0 +1,29 @@
+# Fairphone 5 overlay on upstream device-sc7280 (UFS, 4K sectors).
+# Does not replace device-sc7280. Include pulls in bengalos-kernel-sc7280,
+# the otter DTB and SectorSize=4096. This file only adds the FP5 DTB and
+# the FP5 userspace delta.
+#
+# The old image/device-fp5 profile (microSD, SectorSize=512, 81voltd and
+# hexagon disabled) is not used for this image. The lab phone boots from
+# internal UFS and must keep VoLTE and the sensor stack on.
+[Build]
+Environment=
+        BOS_DEVICE=sc7280
+
+[Include]
+Include=../device-sc7280
+
+[Content]
+# Appended after device-sc7280's otter DTB. The UKI keeps both.
+# linux-image-7.2.8-sc7280+ (7.2.8-bengalos.20261019) already ships
+# qcom/qcm6490-fairphone-fp5.dtb.
+Devicetrees=
+        qcom/qcm6490-fairphone-fp5.dtb
+
+KernelCommandLine=
+        # Camera buffers. Same value as the lab FP5 kernel command line.
+        cma=128M
+
+[Output]
+# Internal UFS logical sectors are 4096 bytes. Not the old SD value of 512.
+SectorSize=4096
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system-preset/09-bengalos-fp5.preset b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system-preset/09-bengalos-fp5.preset
new file mode 100644
index 0000000..0da3706
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system-preset/09-bengalos-fp5.preset
@@ -0,0 +1,19 @@
+# Fairphone 5. This file sorts before 10-bengalos-sc7280.preset.
+# systemd uses the first matching preset line, so the enables here win
+# over the otter preset, which disables 81voltd* and hexagon*.
+# The lab phone needs calling and the sensor stack.
+enable 81voltd*
+enable hexagon*
+enable mnt-persist.mount
+enable fp5-sensors-registry.service
+enable hexagonrpcd.service
+enable hexagonrpcd-adsp-rootpd.service
+enable hexagonrpcd-suspend.service
+enable hexagonrpcd-resume.service
+
+# Never touch A/B slot metadata or bootloader firmware from the OS.
+# qbootctl is also purged (see 50-fp5-remove-qbootctl.sh.chroot).
+disable qbootctl.service
+disable fwupd.service
+disable fwupd-refresh.timer
+disable fwupd-refresh.service
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/fp5-sensors-registry.service b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/fp5-sensors-registry.service
new file mode 100644
index 0000000..641126b
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/fp5-sensors-registry.service
@@ -0,0 +1,18 @@
+# Fairphone 5: copy the Android sensors registry (read-only source) into hexagonrpcd's root.
+# UNVERIFIED source path: Android keeps it in /mnt/vendor/persist/sensors/registry/.
+[Unit]
+Description=Copy FP5 sensors registry from persist (read-only)
+Requires=mnt-persist.mount
+After=mnt-persist.mount droid-juicer.service
+Before=hexagonrpcd.service hexagonrpcd-adsp-rootpd.service
+ConditionPathExists=/mnt/persist/sensors/registry
+ConditionPathExists=!/var/lib/droid-juicer/sensors/sensors/registry
+
+[Service]
+Type=oneshot
+ExecStart=/usr/bin/mkdir -p /var/lib/droid-juicer/sensors/sensors
+ExecStart=/usr/bin/cp -a --no-preserve=ownership /mnt/persist/sensors/registry /var/lib/droid-juicer/sensors/sensors/registry
+ExecStart=/usr/bin/sh -c 'f=/mnt/persist/sensors/sns_reg.conf; [ -f "$f" ] && cp "$f" /var/lib/droid-juicer/sensors/sensors/ || true'
+
+[Install]
+WantedBy=multi-user.target
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service
new file mode 100644
index 0000000..15ce974
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service
@@ -0,0 +1,22 @@
+# Fairphone 5: ADSP root PD instance (Nura runs rootpd + sensorspd; the Debian unit is sensorspd only).
+[Unit]
+Description=Hexagon DSP root PD daemon (ADSP, FP5)
+ConditionPathExists=/var/lib/droid-juicer/sensors/sensors/config
+Conflicts=shutdown.target
+After=multi-user.target
+Before=shutdown.target
+
+[Service]
+Type=simple
+DevicePolicy=closed
+DeviceAllow=/dev/fastrpc-adsp
+ProtectSystem=strict
+ProtectHome=read-only
+PrivateNetwork=yes
+NoNewPrivileges=yes
+ExecStart=/usr/libexec/hexagonrpc/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -R /var/lib/droid-juicer/sensors/
+User=fastrpc
+Group=fastrpc
+
+[Install]
+WantedBy=default.target
