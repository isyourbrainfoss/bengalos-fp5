diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/droid-juicer-fairphone,fp5.toml b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/droid-juicer-fairphone,fp5.toml
new file mode 100644
index 0000000..cd35446
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/droid-juicer-fairphone,fp5.toml
@@ -0,0 +1,49 @@
+# Fairphone 5 droid-juicer config. DRAFT for local testing (BengalOS FP5 prep, 2026-10-27).
+# = upstream droid-juicer configs/fairphone,fp5.toml + QSEE fingerprint trustlet + sensors config.
+# droid-juicer mounts every partition with MS_RDONLY and tries <name>, <name>_a, then <name>_b,
+# so it reads slot A (stock Android). The FP5 udev rule also makes the UFS block devices read-only.
+# Deliberately NO "persist" entry: a failed persist mount would abort the whole extraction.
+# The sensors registry comes from fp5-sensors-registry.service (read-only persist mount) instead.
+[juicer]
+dynpart = "super"
+firmware = [
+    { partition = "vendor", origin = "firmware", destination = "qcom/qcm6490/fairphone5", files = [
+            { name = "a660_zap.mdt" },
+            { name = "aw882xx_acf.bin", rename = "aw88261_acf.bin" },
+            { name = "vpu20_1v.mdt", rename = "venus.mdt" },
+            { name = "yupik_ipa_fws.mdt", rename = "ipa_fws.mdt" },
+        ] },
+    { partition = "modem", origin = "image", destination = "qcom/qcm6490/fairphone5", files = [
+            { name = "adsp.mdt" },
+            { name = "adspr.jsn" },
+            { name = "adsps.jsn" },
+            { name = "adspua.jsn" },
+            { name = "battmgr.jsn" },
+            { name = "cdsp.mdt" },
+            { name = "cdspr.jsn" },
+            { name = "modem.mdt" },
+            { name = "modemr.jsn" },
+            { name = "wpss.mdt" },
+        ] },
+    # Fingerprint trustlet for the QTEE session (fp5-qtee). Android: /vendor/firmware_mnt/image/
+    # = modem_a "image/". Squashed by droid-juicer to /var/lib/firmware/qsee/focal32.mbn.
+    # fingerpr is optional and must NOT be loaded next to focal32 (fp5 TODO F.2); kept out for now.
+    { partition = "modem", origin = "image", destination = "qsee", files = [
+            { name = "focal32.mdt" },
+            # { name = "fingerpr.mdt" },
+        ] },
+    { partition = "bluetooth", origin = "image", destination = "qca", files = [
+            { name = "msbtfw11.mbn" },
+            { name = "msnv11.bin" },
+        ] },
+]
+folders = [
+    { partition = "modem", destination = "qcom/qcm6490/fairphone5", folders = [
+        { name = "image/modem_pr" },
+    ] },
+    # Sensors JSON config for hexagonrpcd's hexagonfs (default root /var/lib/droid-juicer/sensors/).
+    # UNVERIFIED path on the Android side: check `ls /vendor/etc/sensors/config` read-only first.
+    { partition = "vendor", destination = "/var/lib/droid-juicer/sensors/sensors", folders = [
+        { name = "etc/sensors/config" },
+    ] },
+]
diff --git a/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/sysupdate.d/20-uki.transfer b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/sysupdate.d/20-uki.transfer
new file mode 100644
index 0000000..7fc06c6
--- /dev/null
+++ b/mkosi.conf.d/mkosi.profiles/device-sc7280-fp5/mkosi.extra/usr/share/fp5/sysupdate.d/20-uki.transfer
@@ -0,0 +1,36 @@
+# FP5 OVERRIDE of /usr/lib/sysupdate.d/20-uki.transfer (same file name in /etc wins).
+# Why: the official usr is VARIANT_ID=sdm845, so the official transfer would install the sdm845 kernel/DTB.
+# Source = the FP5 feed (PLACEHOLDER, not created yet: GitHub repo isyourbrainfoss/bengalos-fp5, rolling release
+# tag "fp5-feed"; every asset + one SHA256SUMS listing all offered versions live in that single release,
+# because sysupdate needs one directory: https://github.com/systemd/systemd/issues/41977).
+# Target is identical to the official transfer so systemd-boot/bootctl/sysupdate treat it the same way.
+[Transfer]
+ProtectVersion=%A
+# Verify=no: no FP5 signing key yet (same trust as today's local transfers; HTTPS to GitHub only).
+# To sign later: gpg-sign SHA256SUMS -> SHA256SUMS.gpg and APPEND the FP5 public key to a copy of
+# /usr/lib/systemd/import-pubring.gpg in /etc/systemd/import-pubring.gpg (replacing it would break the
+# official usr transfers' verification).
+Verify=no
+
+[Source]
+Type=url-file
+Path=https://github.com/isyourbrainfoss/bengalos-fp5/releases/download/fp5-feed/
+MatchPattern=%M_@v.efi.xz
+
+[Target]
+Type=regular-file
+Path=/EFI/Linux
+PathRelativeTo=boot
+# FP5: same pattern order as the official transfer (the FIRST pattern is the one sysupdate writes), so new
+# UKIs are installed boot-counted (%M_@v_%a+3.efi). Boot counting enabled 2026-11-15 (Kristian: test it).
+# U-Boot already writes this ESP (ubootefi.var, boot-secret-mixin) and fsck.fat is clean.
+MatchPattern=%M_@v_%a+@l.efi \
+             %M_@v_%a.efi \
+             %M_@v+@l-@d.efi \
+             %M_@v+@l.efi \
+             %M_@v.efi
+Mode=0600
+# Boot counting ON (official values). Rollback: /var/lib/fp5-backup/20261115-bootcount/20-uki.transfer
+TriesLeft=3
+TriesDone=0
+InstancesMax=2
