 drivers/firmware/qcom/qcom_qsee_rpmb.c | 612 +++++++++++++++++++++++++
 drivers/firmware/qcom/qcom_scm.c       | 164 +++++++
 include/linux/firmware/qcom/qcom_scm.h |   5 +
 4 files changed, 782 insertions(+)
 create mode 100644 drivers/firmware/qcom/qcom_qsee_rpmb.c

