From 7ede92b76f2cf73e635671280766712d4812d71d Mon Sep 17 00:00:00 2001
From: box <box@localhost>
Date: Tue, 27 Oct 2026 22:18:21 +0100
Subject: [PATCH 4/7] DRAFT arm64: dts: qcom: fp5: add ST21NFCD NFC node
 (untested)

---
 arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
index 4c82bf702..95ce125cf 100644
--- a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
+++ b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
@@ -1096,7 +1096,15 @@ redriver_ss_in: endpoint {
 &i2c9 {
 	status = "okay";
 
-	/* ST21NFC NFC @ 28 */
+	nfc@8 {
+		/* DRAFT (BengalOS FP5 prep), from fp5-nfc README: ST21NFCD, I2C 0x08,
+		 * reset = TLMM 38 (idles high), IRQ = TLMM 41. Untested in this form. */
+		compatible = "st,st21nfcb-i2c";
+		reg = <0x08>;
+		interrupts-extended = <&tlmm 41 IRQ_TYPE_LEVEL_HIGH>;
+		reset-gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+	};
+
 	/* VL53L3 ToF @ 29 */
 };
 
