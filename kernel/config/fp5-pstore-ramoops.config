# FP5 pstore/ramoops + PM sleep debug on top of the 1124.3 built config.
# Nothing else: no LRU_GEN, lockup detectors, DETECT_HUNG_TASK, Gunyah
# watchdog, or Magic SysRq layout changes.
#
# /sys/power/pm_debug_messages and /sys/power/pm_print_times are created by
# PM_SLEEP_DEBUG (def_bool y when PM_DEBUG && PM_SLEEP). PM_ADVANCED_DEBUG
# only adds per-device sysfs attributes and is left off.
# DPM_WATCHDOG and PM_TEST_SUSPEND stay off.

CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_FTRACE is not set
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y
CONFIG_REED_SOLOMON=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_PM_ADVANCED_DEBUG is not set
# CONFIG_PM_TEST_SUSPEND is not set
# CONFIG_DPM_WATCHDOG is not set
