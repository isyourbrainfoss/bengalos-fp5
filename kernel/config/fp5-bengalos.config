# Fairphone 5 additions on top of BengalOS linux-sc7280 (config-7.2.8-sc7280+).
# DRAFT 2026-10-27. Source of the values: Nura live config
# <private handoff>/raw/kernel/config-7.2.9-v2-LIVE (byte-identical to /proc/config.gz).
#
# QTEE (fingerprint QTEE session). Needs patch 0001 (do not select SHMBRIDGE) and
# 0002 (QSEE RPMB listener) from <private handoff>/raw/kernel/patches-v4-usb/.
CONFIG_QCOMTEE=y
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE is not set
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
# Call audio: upstream q6voice (sc7280-mainline PR #35), VoiceMMode1 = PCM 0,7
CONFIG_SND_SOC_QDSP6_Q6VOICE=m
CONFIG_SND_SOC_QDSP6_Q6VOICE_DAI=m
# VoLTE / IMS IPsec (imsd)
CONFIG_XFRM=y
CONFIG_XFRM_ALGO=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ESP=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
# Main camera (Sony IMX800, in-tree driver in sc7280-mainline)
CONFIG_VIDEO_IMX800=m
# cma=128M: passed on the kernel command line by the device-fp5 mkosi profile
# (KernelCommandLine=cma=128M). CONFIG_CMA_SIZE_MBYTES stays 16 like Nura.
# NFC: ST21NFCD (st-nci over I2C). DT node: draft patch in the test tree.
CONFIG_NFC=m
CONFIG_NFC_NCI=m
CONFIG_NFC_ST_NCI=m
CONFIG_NFC_ST_NCI_I2C=m
