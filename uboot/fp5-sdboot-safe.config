# Fairphone 5 SD-boot-only safety fragment (BengalOS prep, 2026-10-27).
# Applied LAST, after qcom_defconfig qcom-phone.config tauchgang.config.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/fp5-sdboot.env"
# No internal storage at all: UFS/SCSI drivers and commands removed.
# CONFIG_UFS is not set
# CONFIG_UFS_QCOM is not set
# CONFIG_SCSI is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_CMD_UFS is not set
# CONFIG_DFU_SCSI is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# No firmware updates from U-Boot (capsules would write the boot partition).
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_CAPSULE_ON_DISK_EARLY is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_RAW is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_MANAGEMENT is not set
# CONFIG_EFI_HAVE_CAPSULE_SUPPORT is not set
# EFI variables in RAM only (nothing persisted anywhere).
CONFIG_EFI_VARIABLE_NO_STORE=y
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
# No fastboot flashing, no USB mass storage export, no env saving.
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_DFU is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU_MMC is not set
# CONFIG_BLKMAP is not set
# CONFIG_CMD_BLKMAP is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_ERASEENV is not set
