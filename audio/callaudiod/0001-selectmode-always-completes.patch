--- a/src/cad-selectmode-decide.c
+++ b/src/cad-selectmode-decide.c
@@ -0,0 +1,108 @@
+/*
+ * See cad-selectmode-decide.h.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#include "cad-selectmode-decide.h"
+
+#include <string.h>
+
+static void finish_list(const CadSelIn *in, CadSelOut *out)
+{
+    if (in->queued)
+        out->step = in->queued_success ? CAD_STEP_OK : CAD_STEP_FAIL;
+    else
+        out->step = CAD_STEP_FAIL;
+}
+
+void cad_selectmode_decide(const CadSelIn *in, CadSelOut *out)
+{
+    if (!out)
+        return;
+    memset(out, 0, sizeof *out);
+    if (!in) {
+        out->step = CAD_STEP_FAIL;
+        return;
+    }
+
+    out->retries_left = in->retries_left;
+    out->queued = in->queued;
+    out->queued_success = in->queued_success;
+    out->suppress_eol = in->suppress_eol;
+    out->skip_mute = in->source_id < 0;
+    out->skip_speaker = in->sink_id < 0;
+
+    /*
+     * Upstream only unmutes and drops the speaker when leaving a call.
+     * Entering a call must not run those side operations.
+     */
+    if (in->phase == CAD_PHASE_ENTER && in->mode != 0) {
+        out->skip_mute = 1;
+        out->skip_speaker = 1;
+    }
+
+    /*
+     * A retry was armed on eol==0. The matching eol>0 belongs to the old
+     * query and must not complete or fail the D-Bus call.
+     */
+    if (in->suppress_eol) {
+        out->step = CAD_STEP_IGNORE;
+        if (in->eol > 0)
+            out->suppress_eol = 0;
+        else
+            out->suppress_eol = 1;
+        return;
+    }
+
+    if (in->phase == CAD_PHASE_ENTER) {
+        if (!in->has_voice && in->sink_id < 0) {
+            out->step = CAD_STEP_FAIL;
+            return;
+        }
+        out->step = CAD_STEP_SET_PROFILE;
+        out->arm_timeout = 1;
+        if (out->retries_left <= 0)
+            out->retries_left = CAD_SELECT_RETRIES;
+        return;
+    }
+
+    /* CARD and PORT: one PulseAudio info list. */
+    if (in->async_started) {
+        out->step = CAD_STEP_IGNORE;
+        return;
+    }
+    if (in->eol < 0) {
+        out->step = CAD_STEP_FAIL;
+        return;
+    }
+    if (in->eol > 0) {
+        finish_list(in, out);
+        return;
+    }
+
+    /*
+     * eol == 0. Do not complete yet: PulseAudio calls the callback again
+     * with eol>0, and freeing here is the 0.1.99 use-after-free.
+     */
+    if (in->active == CAD_ACTIVE_UNKNOWN || !in->target_available) {
+        if (in->retries_left > 0) {
+            out->step = CAD_STEP_RETRY;
+            out->retries_left = in->retries_left - 1;
+            out->suppress_eol = 1;
+            out->arm_timeout = 1;
+            return;
+        }
+        out->queued = 1;
+        out->queued_success = 0;
+        out->step = CAD_STEP_IGNORE;
+        return;
+    }
+    if (in->already_there) {
+        out->queued = 1;
+        out->queued_success = 1;
+        out->step = CAD_STEP_IGNORE;
+        return;
+    }
+    out->step = CAD_STEP_SET_PROFILE;
+    out->arm_timeout = 1;
+}
--- a/src/cad-selectmode-decide.h
+++ b/src/cad-selectmode-decide.h
@@ -0,0 +1,66 @@
+/*
+ * Decision helper for callaudiod 0.1.99 SelectMode.
+ *
+ * The PulseAudio backend calls this and does the I/O itself. This file has
+ * no PulseAudio and no GLib types, so the host build can unit-test it.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifndef CAD_SELECTMODE_DECIDE_H
+#define CAD_SELECTMODE_DECIDE_H
+
+enum {
+    CAD_STEP_OK = 0,          /* complete the D-Bus call successfully now */
+    CAD_STEP_FAIL = 1,        /* complete the D-Bus call with an error now */
+    CAD_STEP_SET_PROFILE = 2, /* start the async PulseAudio operation */
+    CAD_STEP_RETRY = 3,       /* ask PulseAudio again after a short delay */
+    CAD_STEP_IGNORE = 4       /* do not complete and do not free */
+};
+
+enum {
+    CAD_PHASE_ENTER = 0, /* before any PulseAudio info query */
+    CAD_PHASE_CARD = 1,  /* pa_context_get_card_info callback */
+    CAD_PHASE_PORT = 2   /* pa_context_get_sink_info callback */
+};
+
+enum {
+    CAD_ACTIVE_UNKNOWN = 0,
+    CAD_ACTIVE_VOICE = 1,
+    CAD_ACTIVE_HIFI = 2,
+    CAD_ACTIVE_OTHER = 3
+};
+
+/* Short bound: 5 retries, 200 ms apart, under the 2.5 s SelectMode timeout. */
+#define CAD_SELECT_RETRIES 5
+
+typedef struct {
+    int mode;             /* 0 = default (HiFi), 1 = voice call */
+    int has_voice;        /* card has a Voice Call profile */
+    int source_id;        /* <0 : no usable source */
+    int sink_id;          /* <0 : no usable sink */
+    int phase;
+    int eol;              /* <0 error, 0 one info item, >0 end of list */
+    int active;           /* CAD_ACTIVE_* */
+    int target_available; /* a suitable target profile or port exists */
+    int already_there;    /* active profile or port is already the target */
+    int async_started;    /* set_card_profile / set_sink_port is in flight */
+    int queued;           /* a result is waiting for eol>0 */
+    int queued_success;
+    int retries_left;
+    int suppress_eol;     /* ignore the rest of this PulseAudio list */
+} CadSelIn;
+
+typedef struct {
+    int step;
+    int skip_mute;        /* do not call mute-mic (source already gone) */
+    int skip_speaker;     /* do not call enable-speaker (sink already gone) */
+    int arm_timeout;      /* arm the SelectMode deadline if not armed yet */
+    int retries_left;
+    int queued;
+    int queued_success;
+    int suppress_eol;
+} CadSelOut;
+
+void cad_selectmode_decide(const CadSelIn *in, CadSelOut *out);
+
+#endif
