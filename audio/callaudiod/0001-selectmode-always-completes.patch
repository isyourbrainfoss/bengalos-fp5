+/* Complete the D-Bus invocation with a failure.
+ * free_now is FALSE while a PulseAudio callback may still arrive: that
+ * callback frees the wrapper. Freeing it here would use-after-free.
+ * One CadPulseOperation can leak if Pulse never calls back after a timeout.
+ * The invocation is already completed, so the daemon is not wedged.
+ */
+static void cad_pulse_op_fail(CadPulseOperation *operation, gboolean free_now)
+{
+    if (!operation || operation->done)
+        return;
+    operation->done = TRUE;
+    cad_pulse_op_disarm(operation);
+    if (operation->op) {
+        operation->op->success = FALSE;
+        if (operation->op->callback)
+            operation->op->callback(operation->op);
+        free(operation->op);
+        operation->op = NULL;
+    }
+    if (free_now) {
+        g_free(operation->profile_name);
+        operation->profile_name = NULL;
+        free(operation);
+    }
+}
