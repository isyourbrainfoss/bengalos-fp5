_print = False


def log(msg, prio=syslog.LOG_INFO):
    msg = redact(msg)
    if _print:
        print("fp5-hfp-modem-bridge: " + msg, file=sys.stderr, flush=True)
    else:
        syslog.syslog(prio, msg)


def errname(e):
    """Only the D-Bus error name: imsd error texts can carry SIP URIs/domains."""
    return Gio.DBusError.get_remote_error(e) or "error %d" % e.code


def redact(s):
    s = re.sub(r"([0-9A-Fa-f]{2}[:_-]){5}[0-9A-Fa-f]{2}", "XX:XX", str(s))
    return re.sub(r"\+?[0-9][0-9 ]{5,}[0-9]", "<num>", s)


class Call:
    """One car-visible call. origin "ims": props are oFono VoiceCall props;
    origin "cs": props are ModemManager Call props (same enums as ours)."""
    def __init__(self, idx, backend_path, props, origin=ORIGIN_IMS):
        self.path = "%s%d" % (CALL_PREFIX, idx)
        self.origin = origin
        self.backend_path = backend_path
        if origin == ORIGIN_CS:
            self.state = int(props.get("State", MM_CALL_STATE_UNKNOWN))
            self.direction = int(props.get("Direction", MM_DIR_OUTGOING)) or MM_DIR_OUTGOING
            self.number = props.get("Number", "") or ""
        else:
            st = props.get("State", "dialing")
            self.state = MM_CALL_STATE.get(st, MM_CALL_STATE_UNKNOWN)
            self.direction = MM_DIR_INCOMING if st in ("incoming", "waiting") else MM_DIR_OUTGOING
            self.number = props.get("LineIdentification", "") or ""
        self.reason = REASON_INCOMING if self.direction == MM_DIR_INCOMING else REASON_OUTGOING
        self.multiparty = bool(props.get("Multiparty", False))
        self.reg_id = 0

    @property
    def ofono_path(self):
        return self.backend_path

    def props(self):
        return {"State": GLib.Variant("i", self.state),
                "StateReason": GLib.Variant("i", self.reason),
                "Direction": GLib.Variant("i", self.direction),
                "Number": GLib.Variant("s", self.number),
                "Multiparty": GLib.Variant("b", self.multiparty)}


CALLS_UNIT = "calls-daemon.service"
CALLS_STALE_MARK = "Ofono vanished from D-Bus"
REFRESH_DELAY_S = 5


def _run(argv, timeout=10):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError):
        return -1, ""


class CallsRefresher:
    """Restart gnome-calls (calls-daemon) when it holds a dead oFono modem.
    stale: gnome-calls has seen org.ofono vanish since it started. Restart
    only once org.ofono is back and no call is live; never during a call."""
    def __init__(self, busy, run=_run, timers=True, log=None, delay_s=REFRESH_DELAY_S):
        self.busy, self.run, self.timers = busy, run, timers
        self.log = log or (lambda m: None)
        self.delay_s = delay_s
        self.stale = False
        self.ofono_up = False
        self.timer = None
        self.waiting = False
        self.restarts = 0

    def startup_check(self):
        """Does the running gnome-calls already hold a dead modem? Only a fixed
        string is looked for in its own journal lines; nothing is logged."""
        rc, out = self.run(["systemctl", "--user", "show", "-p", "MainPID", "--value", CALLS_UNIT])
        pid = out.strip() if rc == 0 else ""
        if not pid.isdigit() or pid == "0":
            return False
        rc, out = self.run(["journalctl", "--user", "-b", "_PID=" + pid, "-o", "cat", "--no-pager"], 20)
        if rc == 0 and CALLS_STALE_MARK in out:
            self.stale = True
            self.log("gnome-calls: running instance lost oFono earlier (stale modem); refresh when idle")
        return self.stale

    def ofono_gone(self):
        self.ofono_up = False
        self.stale = True
        self._cancel()

    def ofono_back(self):
        self.ofono_up = True
        self._schedule()

    def calls_idle(self):
        if self.waiting:
            self._schedule()

    def _cancel(self):
        if self.timer is not None and self.timers:
            GLib.source_remove(self.timer)
        self.timer = None

    def _schedule(self):
        if not self.stale or not self.ofono_up or self.timer is not None:
            return
        if not self.timers:
            return self._fire()
        def cb():
            self.timer = None
            self._fire()
            return False
        self.timer = GLib.timeout_add_seconds(self.delay_s, cb)

    def _fire(self):
        if not self.stale or not self.ofono_up:
            return False
        if self.busy():
            if not self.waiting:
                self.log("gnome-calls: stale oFono modem, waiting for the call to end before refreshing")
            self.waiting = True
            return False
        self.waiting = False
        rc, _ = self.run(["systemctl", "--user", "try-restart", CALLS_UNIT], 30)
        self.stale = rc != 0
        self.restarts += rc == 0
        self.log("gnome-calls: %s after imsd-ofonod came back (stale oFono modem)"
                 % ("restarted" if rc == 0 else "restart FAILED rc=%d" % rc))
        return rc == 0


GHOST_DELAY_S = 8        # gnome-calls drops an ended call after 3 s
GHOST_RECHECK_S = 5
GHOST_GAP_S = 600        # at most one ghost-call restart per 10 min
CUI_DISCONNECTED = 7     # org.gnome.Calls.Call State: 7 = ended


class GhostCallCheck:
    """After a call ends (bridge and imsd/ModemManager idle), gnome-calls must
    not still export a live org.gnome.Calls.Call: Phosh treats one as an active
    call (proximity blanking, lock screen). Seen 20.11 17:15 (Call/3 left in
    state 3 'calling'). If one is still there after GHOST_DELAY_S and again
    GHOST_RECHECK_S later, try-restart calls-daemon (never during a call, at
    most once per 10 min). Only object paths and states are read."""
    def __init__(self, busy, list_calls, run=_run, timers=True, log=None, clock=time.monotonic):
        self.busy, self.list_calls, self.run, self.timers = busy, list_calls, run, timers
        self.log = log or (lambda m: None)
        self.clock = clock
        self.timer = None
        self.last = -1e9
        self.restarts = 0

    def call_ended(self):
        self._later(GHOST_DELAY_S, lambda: self._check(first=True))

    def _later(self, s, fn):
        if not self.timers:
            return fn()
        if self.timer is not None:
            GLib.source_remove(self.timer)
        def cb():
            self.timer = None
            fn()
            return False
        self.timer = GLib.timeout_add_seconds(s, cb)

    def _ghosts(self):
        try:
            return [p for p, st in self.list_calls() if st != CUI_DISCONNECTED]
        except Exception:
            return []  # gnome-calls not running / no answer: nothing to fix

    def _check(self, first):
        if self.busy():
            return False
        ghosts = self._ghosts()
        if not ghosts:
            return False
        if first:
            self.log("gnome-calls: %d call object(s) still live after the call ended; re-checking" % len(ghosts))
            self._later(GHOST_RECHECK_S, lambda: self._check(first=False))
            return False
        if self.clock() - self.last < GHOST_GAP_S:
            self.log("gnome-calls: ghost call still there, restart skipped (one per 10 min)")
            return False
        self.last = self.clock()
        rc, _ = self.run(["systemctl", "--user", "try-restart", CALLS_UNIT], 30)
        self.restarts += rc == 0
        self.log("gnome-calls: %s (ghost call left after the call ended)"
                 % ("restarted" if rc == 0 else "restart FAILED rc=%d" % rc))
        return rc == 0


def gnome_calls_list(sesbus):
    """[(object path, State)] of org.gnome.Calls.Call objects (no numbers/names)."""
    r = sesbus.call_sync("org.gnome.Calls", "/org/gnome/Calls", "org.freedesktop.DBus.ObjectManager",
                         "GetManagedObjects", None, GLib.VariantType("(a{oa{sa{sv}}})"),
                         Gio.DBusCallFlags.NO_AUTO_START, 3000, None).unpack()[0]
    out = []
    for path, ifs in r.items():
        c = ifs.get("org.gnome.Calls.Call")
        if c is not None:
            out.append((path, int(c.get("State", 0))))
    return out


class Bridge:
    def __init__(self, bus, ofono_bus, mm_bus, audio=None, allow_uids=None, refresher=None):
        self.bus = bus
        self.ofono_bus = ofono_bus
        self.mm_bus = mm_bus
        self.audio = audio
        self.refresher = refresher
        self.ghost = None
        self._was_live = False
        self.read_logged = set()  # calls whose state PipeWire has read (logged once)
        self._ofono_seen = False
        self.allow_uids = allow_uids if allow_uids is not None else {0, os.getuid()}
        self.calls = {}          # ofono path -> Call
        self.next_idx = 0
        self.ofono_modem = None  # path
        self.ofono_online = False
        self.mm_state = 0
        self.mm_modem = None
        self.mm_has_voice = False
        self.mm_emergency_only = False
        self.ims_added = 0
        self.cs_pending = {}     # MM call path -> callbacks waiting for GetAll
        self.signal = (0, False)
        self.operator = ""
        self.regstate = 0
        self.reg_ids = []
        self.subs = []
        self.uid_cache = {}

    # ---------------- export ----------------
    def export(self):
        b = self.bus
        self.reg_ids.append(b.register_object(MM_ROOT, IFACE[IF_OM], self._method, None, None))
        for name in (IF_MODEM, IF_3GPP, IF_VOICE):
            self.reg_ids.append(b.register_object(MODEM_PATH, IFACE[name], self._method,
                                                  self._get_prop, None))

    def modem_props(self, iface):
        if iface == IF_MODEM:
            return {"Device": GLib.Variant("s", MODEM_DEVICE),
                    "Manufacturer": GLib.Variant("s", "Fairphone"),
                    "Model": GLib.Variant("s", "FP5 imsd"),
                    "State": GLib.Variant("i", self.state()),
                    "SignalQuality": GLib.Variant("(ub)", self.signal)}
        if iface == IF_3GPP:
            return {"OperatorName": GLib.Variant("s", self.operator),
                    "RegistrationState": GLib.Variant("u", self.regstate)}
        if iface == IF_VOICE:
            return {"Calls": GLib.Variant("ao", [c.path for c in self.calls.values()])}
        return {}

    def ims_ok(self):
        return bool(self.ofono_modem and self.ofono_online)

    def cs_ok(self):
        return bool(self.mm_modem and self.mm_has_voice and not self.mm_emergency_only
                    and self.mm_state >= MM_MODEM_STATE_REGISTERED)

    def state(self):
        # "has service" for the car == some path can place a call right now.
        if self.ims_ok() or self.cs_ok():
            return MM_MODEM_STATE_REGISTERED
        return MM_MODEM_STATE_ENABLED

    def _get_prop(self, conn, sender, path, iface, prop):
        if path == MODEM_PATH:
            return self.modem_props(iface).get(prop)
        for c in self.calls.values():
            if c.path == path:
                if prop == "State" and c.path not in self.read_logged:
                    self.read_logged.add(c.path)
                    log("car side read call %s (state %d)" % (c.path.rsplit("/", 1)[-1], c.state))
                return c.props().get(prop)
        return None

    def _emit_props(self, path, iface, changed):
        self.bus.emit_signal(None, path, IF_PROPS, "PropertiesChanged",
                             GLib.Variant("(sa{sv}as)", (iface, changed, [])))

    def _modem_changed(self, iface, *keys):
        p = self.modem_props(iface)
        self._emit_props(MODEM_PATH, iface, {k: p[k] for k in keys})

    # ---------------- access control ----------------
    def _uid_of(self, sender):
        if sender in self.uid_cache:
            return self.uid_cache[sender]
        try:
            r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "GetConnectionUnixUser",
                                   GLib.Variant("(s)", (sender,)), GLib.VariantType("(u)"),
                                   Gio.DBusCallFlags.NONE, 2000, None)
            uid = r.unpack()[0]
        except GLib.Error:
            uid = None
        self.uid_cache[sender] = uid
        return uid

    # ---------------- method dispatch ----------------
    def _method(self, conn, sender, path, iface, method, params, inv):
        try:
            if iface == IF_OM and method == "GetManagedObjects":
                return inv.return_value(GLib.Variant("(a{oa{sa{sv}}})", (self.managed_objects(),)))
            if self._uid_of(sender) not in self.allow_uids:
                log("refused %s.%s from uid %s" % (iface.rsplit(".", 1)[-1], method, self._uid_of(sender)),
                    syslog.LOG_WARNING)
                return inv.return_dbus_error(ERR_DENIED, "not allowed")
            if iface == IF_VOICE and method == "CreateCall":
                return self.create_call(params.unpack()[0], inv)
            if iface == IF_VOICE and method == "HangupAll":
                return self.hangup_all(inv)
            call = next((c for c in self.calls.values() if c.path == path), None)
            if iface == IF_CALL:
                if call is None:
                    log("car: %s on unknown call %s" % (method, path.rsplit("/", 1)[-1]), syslog.LOG_WARNING)
                    return inv.return_dbus_error(ERR_FAILED, "no such call")
                if method == "Start":
                    return inv.return_value(None)  # oFono Dial already started it
                cs = call.origin == ORIGIN_CS
                if method == "Accept":
                    log("car: accept %s (%s)" % (call.path.rsplit("/", 1)[-1], call.origin))
                    if cs:
                        return self._mm(call.backend_path, IF_CALL, "Accept", None, inv)
                    return self._ofono(call.ofono_path, "org.ofono.VoiceCall", "Answer", None, inv)
                if method == "Hangup":
                    log("car: hangup %s (%s)" % (call.path.rsplit("/", 1)[-1], call.origin))
                    if cs:
                        return self._mm(call.backend_path, IF_CALL, "Hangup", None, inv)
                    return self._ofono(call.ofono_path, "org.ofono.VoiceCall", "Hangup", None, inv)
                if method == "SendDtmf":
                    tones = params.unpack()[0]
                    if not DTMF_RE.match(tones):
                        return inv.return_dbus_error(ERR_ARGS, "invalid dtmf")
                    if cs:
                        return self._mm(call.backend_path, IF_CALL, "SendDtmf", GLib.Variant("(s)", (tones,)), inv)
                    return self._ofono_vcm("SendTones", GLib.Variant("(s)", (tones,)), inv)
            inv.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
        except Exception as e:  # never let a car command kill the daemon
            log("method %s failed: %s" % (method, e), syslog.LOG_ERR)
            inv.return_dbus_error(ERR_FAILED, "internal error")

    def managed_objects(self):
        objs = {MODEM_PATH: {i: self.modem_props(i) for i in (IF_MODEM, IF_3GPP, IF_VOICE)}}
        for c in self.calls.values():
            objs[c.path] = {IF_CALL: c.props()}
        return objs

    def create_call(self, props, inv):
        number = props.get("number")
        if not isinstance(number, str) or not DIAL_RE.match(number):
            return inv.return_dbus_error(ERR_ARGS, "invalid number")
        if self.ims_ok():
            log("car: dial request via VoLTE")
            return self._prepare_audio(lambda: self._dial_ims(number, inv))
        if self.cs_ok():
            log("car: dial request via CS (IMS not available)")
            return self._prepare_audio(lambda: self._dial_cs(number, inv))
        log("car: dial request refused: no VoLTE and no CS", syslog.LOG_WARNING)
        return inv.return_dbus_error(ERR_FAILED, "no service")

    def _prepare_audio(self, dial):
        """Car audio to HFP + car defaults BEFORE dialling, so imsd-media's
        pw-play/pw-record (spawned at media start) open on the car directly."""
        if not self.audio:
            return dial()
        self.audio.prepare(dial)

    def _audio_abort(self):
        if self.audio and not any(c.state != MM_CALL_STATE_TERMINATED for c in self.calls.values()):
            self.audio.abort_prepare()

    def _dial_ims(self, number, inv):
        if not self.ofono_modem:  # imsd went away while car audio was prepared
            self._audio_abort()
            return inv.return_dbus_error(ERR_FAILED, "imsd not available")
        t0 = GLib.get_monotonic_time()
        seen0 = self.ims_added

        def done(src, res):
            try:
                opath = src.call_finish(res).unpack()[0]
            except GLib.Error as e:
                took = (GLib.get_monotonic_time() - t0) / 1e6
                # any imsd call object (even one already gone, e.g. busy) means the
                # network saw the attempt: never re-dial over CS then
                new_ims = self.ims_added != seen0
                log("VoLTE Dial failed after %.1f s: %s" % (took, errname(e)), syslog.LOG_WARNING)
                if took < FAST_FAIL_S and not new_ims and self.cs_ok():
                    log("falling back to CS")
                    return self._dial_cs(number, inv)
                self._audio_abort()
                return inv.return_dbus_error(ERR_FAILED, "dial failed")
            call = self.calls.get(opath) or self._add_call(opath, {"State": "dialing"})
            log("car: dial accepted after %.1f s (OK to the car)" % ((GLib.get_monotonic_time() - t0) / 1e6))
            inv.return_value(GLib.Variant("(o)", (call.path,)))
        self.ofono_bus.call("org.ofono", self.ofono_modem, "org.ofono.VoiceCallManager", "Dial",
                            GLib.Variant("(ss)", (number, "")), GLib.VariantType("(o)"),
                            Gio.DBusCallFlags.NONE, 30000, None, done)

    def _dial_cs(self, number, inv):
        def created(src, res):
            try:
                mpath = src.call_finish(res).unpack()[0]
            except GLib.Error as e:
                log("CS CreateCall failed: %s" % errname(e), syslog.LOG_WARNING)
                self._audio_abort()
                return inv.return_dbus_error(ERR_FAILED, "dial failed")
            self._add_cs_call(mpath, lambda call: start(call))

        def start(call):
            def started(src2, res2):
                try:
                    src2.call_finish(res2)
                except GLib.Error as e:
                    log("CS Start failed: %s" % errname(e), syslog.LOG_WARNING)
                    self.mm_bus.call(MM_SERVICE, self.mm_modem, IF_VOICE, "DeleteCall",
                                     GLib.Variant("(o)", (mpath,)), None, Gio.DBusCallFlags.NONE,
                                     5000, None, None)
                    self._audio_abort()
                    return inv.return_dbus_error(ERR_FAILED, "dial failed")
                inv.return_value(GLib.Variant("(o)", (call.path,)))
            if call is None:
                self._audio_abort()
                return inv.return_dbus_error(ERR_FAILED, "dial failed")
            mpath = call.backend_path
            self.mm_bus.call(MM_SERVICE, mpath, IF_CALL, "Start", None, None,
                             Gio.DBusCallFlags.NONE, 60000, None, started)
        self.mm_bus.call(MM_SERVICE, self.mm_modem, IF_VOICE, "CreateCall",
                         GLib.Variant("(a{sv})", ({"number": GLib.Variant("s", number)},)),
                         GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE, 15000, None, created)

    def hangup_all(self, inv):
        log("car: hang up all (%d call(s) known here)" % len(self.calls))
        pending = []
        if self.ofono_modem and any(c.origin == ORIGIN_IMS for c in self.calls.values()):
            pending.append((self.ofono_bus, "org.ofono", self.ofono_modem, "org.ofono.VoiceCallManager"))
        if self.mm_modem and any(c.origin == ORIGIN_CS for c in self.calls.values()):
            pending.append((self.mm_bus, MM_SERVICE, self.mm_modem, IF_VOICE))
        if not pending:
            return inv.return_value(None)
        for bus, name, path, iface in pending:
            bus.call(name, path, iface, "HangupAll", None, None, Gio.DBusCallFlags.NONE, 15000, None, None)
        inv.return_value(None)

    def _mm(self, path, iface, method, args, inv):
        def done(src, res):
            try:
                src.call_finish(res)
                inv.return_value(None)
            except GLib.Error as e:
                log("CS %s failed: %s" % (method, errname(e)), syslog.LOG_WARNING)
                inv.return_dbus_error(ERR_FAILED, method + " failed")
        self.mm_bus.call(MM_SERVICE, path, iface, method, args, None,
                         Gio.DBusCallFlags.NONE, 15000, None, done)

    def _ofono(self, path, iface, method, args, inv):
        def done(src, res):
            try:
                src.call_finish(res)
                inv.return_value(None)
            except GLib.Error as e:
                log("%s failed: %s" % (method, errname(e)), syslog.LOG_WARNING)
                inv.return_dbus_error(ERR_FAILED, method + " failed")
        self.ofono_bus.call("org.ofono", path, iface, method, args, None,
                            Gio.DBusCallFlags.NONE, 15000, None, done)

    def _ofono_vcm(self, method, args, inv):
        if not self.ofono_modem:
            return inv.return_dbus_error(ERR_FAILED, "imsd not available")
        return self._ofono(self.ofono_modem, "org.ofono.VoiceCallManager", method, args, inv)

    # ---------------- call mirror ----------------
    def _add_call(self, opath, props, origin=ORIGIN_IMS):
        if opath in self.calls:
            return self.calls[opath]
        call = Call(self.next_idx, opath, props, origin)
        if origin == ORIGIN_IMS:
            self.ims_added += 1
        self.next_idx += 1
        self.calls[opath] = call
        call.reg_id = self.bus.register_object(call.path, IFACE[IF_CALL], self._method, self._get_prop, None)
        self.bus.emit_signal(None, MM_ROOT, IF_OM, "InterfacesAdded",
                             GLib.Variant("(oa{sa{sv}})", (call.path, {IF_CALL: call.props()})))
        self.bus.emit_signal(None, MODEM_PATH, IF_VOICE, "CallAdded", GLib.Variant("(o)", (call.path,)))
        self._modem_changed(IF_VOICE, "Calls")
        log("call %s added (%s) dir=%s state=%d" % (call.path.rsplit("/", 1)[-1], origin,
            "in" if call.direction == MM_DIR_INCOMING else "out", call.state))
        self._audio()
        return call

    def _add_cs_call(self, mpath, then=None):
        """Read a ModemManager call's properties first, then publish it, so
        PipeWire's GetAll on CallAdded already sees direction and number."""
        if mpath in self.calls:
            return then and then(self.calls[mpath])
        in_flight = mpath in self.cs_pending
        waiters = self.cs_pending.setdefault(mpath, [])
        if then:
            waiters.append(then)
        if in_flight:
            return

        def got(src, res):
            cbs = self.cs_pending.pop(mpath, [])
            try:
                p = src.call_finish(res).unpack()[0]
            except GLib.Error as e:
                log("CS call GetAll failed: %s" % errname(e), syslog.LOG_WARNING)
                p = None
            call = None
            if p is not None and int(p.get("State", 0)) != MM_CALL_STATE_TERMINATED:
                call = self._add_call(mpath, p, ORIGIN_CS)
            for cb in cbs:
                cb(call)
        self.mm_bus.call(MM_SERVICE, mpath, IF_PROPS, "GetAll", GLib.Variant("(s)", (IF_CALL,)),
                         GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 5000, None, got)

    def _set_call_state(self, call, new, reason):
        if new == call.state:
            return
        old, call.state, call.reason = call.state, new, reason
        self.bus.emit_signal(None, call.path, IF_CALL, "StateChanged", GLib.Variant("(iiu)", (old, new, reason)))
        self._emit_props(call.path, IF_CALL, {"State": GLib.Variant("i", new),
                                              "StateReason": GLib.Variant("i", reason)})
        log("call %s state %d -> %d" % (call.path.rsplit("/", 1)[-1], old, new))
        self._audio()

    def _remove_call(self, opath):
        call = self.calls.get(opath)
        if call is None:
            return
        self._set_call_state(call, MM_CALL_STATE_TERMINATED, REASON_TERMINATED)
        del self.calls[opath]
        self.bus.emit_signal(None, MODEM_PATH, IF_VOICE, "CallDeleted", GLib.Variant("(o)", (call.path,)))
        self.bus.emit_signal(None, MM_ROOT, IF_OM, "InterfacesRemoved",
                             GLib.Variant("(oas)", (call.path, [IF_CALL])))
        self.bus.unregister_object(call.reg_id)
        self._modem_changed(IF_VOICE, "Calls")
        log("call %s removed" % call.path.rsplit("/", 1)[-1])
        self._audio()

    def _drop_all_calls(self, origin=ORIGIN_IMS):
        for opath in [k for k, c in self.calls.items() if c.origin == origin]:
            self._remove_call(opath)

    def live_calls(self):
        return [c for c in self.calls.values() if c.state != MM_CALL_STATE_TERMINATED]

    def _audio(self):
        live = self.live_calls()
        if self.audio:
            self.audio.calls_changed(len(live))
        if self.refresher and not live:
            self.refresher.calls_idle()
        if live:
            self._was_live = True
        elif self._was_live:
            self._was_live = False
            if self.ghost:
                self.ghost.call_ended()

    # ---------------- oFono (imsd-ofonod) side ----------------
    def watch_ofono(self):
        sub = self.ofono_bus.signal_subscribe
        self.subs.append(sub("org.ofono", "org.ofono.Manager", None, None, None,
                             Gio.DBusSignalFlags.NONE, self._on_ofono_manager))
        self.subs.append(sub("org.ofono", "org.ofono.Modem", "PropertyChanged", None, None,
                             Gio.DBusSignalFlags.NONE, self._on_ofono_modem_prop))
        self.subs.append(sub("org.ofono", "org.ofono.VoiceCallManager", None, None, None,
                             Gio.DBusSignalFlags.NONE, self._on_vcm))
        self.subs.append(sub("org.ofono", "org.ofono.VoiceCall", "PropertyChanged", None, None,
                             Gio.DBusSignalFlags.NONE, self._on_call_prop))
        Gio.bus_watch_name_on_connection(self.ofono_bus, "org.ofono", Gio.BusNameWatcherFlags.NONE,
                                         self._ofono_appeared, self._ofono_vanished)

    def _ofono_appeared(self, conn, name, owner):
        log("imsd-ofonod appeared")
        self._ofono_seen = True
        if self.refresher:
            self.refresher.ofono_back()
        conn.call("org.ofono", "/", "org.ofono.Manager", "GetModems", None,
                  GLib.VariantType("(a(oa{sv}))"), Gio.DBusCallFlags.NONE, 5000, None, self._got_modems)

    def _got_modems(self, src, res):
        try:
            modems = src.call_finish(res).unpack()[0]
        except GLib.Error as e:
            log("GetModems failed: %s" % errname(e), syslog.LOG_WARNING)
            return
        for path, props in modems:
            if "org.ofono.VoiceCallManager" in props.get("Interfaces", []) or len(modems) == 1:
                self._use_modem(path, props)
                break

    def _use_modem(self, path, props):
        self.ofono_modem = path
        self.ofono_online = bool(props.get("Online", False))
        self._modem_changed(IF_MODEM, "State")
        self.ofono_bus.call("org.ofono", path, "org.ofono.VoiceCallManager", "GetCalls", None,
                            GLib.VariantType("(a(oa{sv}))"), Gio.DBusCallFlags.NONE, 5000, None,
                            self._got_calls)

    def _got_calls(self, src, res):
        try:
            for opath, props in src.call_finish(res).unpack()[0]:
                self._add_call(opath, props)
        except GLib.Error as e:
            log("GetCalls failed: %s" % errname(e), syslog.LOG_WARNING)

    def _ofono_vanished(self, conn, name):
        if self._ofono_seen and self.refresher:
            self.refresher.ofono_gone()
        if self.ofono_modem:
            log("imsd-ofonod vanished")
        self.ofono_modem = None
        self.ofono_online = False
        self._drop_all_calls()
        self._modem_changed(IF_MODEM, "State")

    def _on_ofono_manager(self, conn, sender, path, iface, sig, params):
        if sig == "ModemAdded" and not self.ofono_modem:
            p, props = params.unpack()
            self._use_modem(p, props)
        elif sig == "ModemRemoved" and params.unpack()[0] == self.ofono_modem:
            self._ofono_vanished(conn, "org.ofono")

    def _on_ofono_modem_prop(self, conn, sender, path, iface, sig, params):
        if path != self.ofono_modem:
            return
        name, value = params.unpack()
        if name == "Online":
            self.ofono_online = bool(value)
            self._modem_changed(IF_MODEM, "State")
        elif name == "Interfaces" and "org.ofono.VoiceCallManager" not in value:
            self._drop_all_calls()

    def _on_vcm(self, conn, sender, path, iface, sig, params):
        if path != self.ofono_modem:
            return
        if sig == "CallAdded":
            opath, props = params.unpack()
            call = self.calls.get(opath)
            if call is None:
                self._add_call(opath, props)
            elif "State" in props:
                self._apply_ofono_state(call, props["State"])
        elif sig == "CallRemoved":
            self._remove_call(params.unpack()[0])

    def _on_call_prop(self, conn, sender, path, iface, sig, params):
        call = self.calls.get(path)
        if call is None or call.origin != ORIGIN_IMS:
            return
        name, value = params.unpack()
        if name == "State":
            self._apply_ofono_state(call, value)
        elif name == "LineIdentification":
            call.number = value or ""
            self._emit_props(call.path, IF_CALL, {"Number": GLib.Variant("s", call.number)})
        elif name == "Multiparty":
            call.multiparty = bool(value)
            self._emit_props(call.path, IF_CALL, {"Multiparty": GLib.Variant("b", call.multiparty)})

    def _apply_ofono_state(self, call, st):
        new = MM_CALL_STATE.get(st, MM_CALL_STATE_UNKNOWN)
        reason = {4: REASON_ACCEPTED, 7: REASON_TERMINATED}.get(new, call.reason)
        self._set_call_state(call, new, reason)

    # ---------------- real ModemManager (read-only mirror) ----------------
    def watch_mm(self):
        if self.mm_bus is None:
            return
        self.subs.append(self.mm_bus.signal_subscribe(MM_SERVICE, IF_PROPS,
                         "PropertiesChanged", None, None, Gio.DBusSignalFlags.NONE, self._on_mm_props))
        self.subs.append(self.mm_bus.signal_subscribe(MM_SERVICE, IF_VOICE, None, None, None,
                         Gio.DBusSignalFlags.NONE, self._on_mm_voice))
        self.subs.append(self.mm_bus.signal_subscribe(MM_SERVICE, IF_CALL, "StateChanged", None, None,
                         Gio.DBusSignalFlags.NONE, self._on_mm_call_state))
        self.subs.append(self.mm_bus.signal_subscribe(MM_SERVICE, IF_OM, None, MM_ROOT, None,
                         Gio.DBusSignalFlags.NONE, self._on_mm_om))
        Gio.bus_watch_name_on_connection(self.mm_bus, "org.freedesktop.ModemManager1",
                                         Gio.BusNameWatcherFlags.NONE, self._mm_appeared, self._mm_vanished)

    def _mm_appeared(self, conn, name, owner):
        conn.call("org.freedesktop.ModemManager1", MM_ROOT, IF_OM, "GetManagedObjects", None,
                  GLib.VariantType("(a{oa{sa{sv}}})"), Gio.DBusCallFlags.NONE, 5000, None, self._got_mm)

    def _got_mm(self, src, res):
        try:
            objs = src.call_finish(res).unpack()[0]
        except GLib.Error as e:
            log("ModemManager GetManagedObjects failed: %s" % errname(e), syslog.LOG_WARNING)
            return
        for path, ifaces in objs.items():
            if IF_MODEM in ifaces:
                self.mm_modem = path
                self._mm_apply(IF_MODEM, ifaces[IF_MODEM])
                if IF_3GPP in ifaces:
                    self._mm_apply(IF_3GPP, ifaces[IF_3GPP])
                self.mm_has_voice = IF_VOICE in ifaces
                if self.mm_has_voice:
                    self._mm_apply(IF_VOICE, ifaces[IF_VOICE])
                    for cpath in ifaces[IF_VOICE].get("Calls", []):
                        self._add_cs_call(cpath)
                self._modem_changed(IF_MODEM, "State")
                break

    def _mm_vanished(self, conn, name):
        self.mm_modem, self.mm_state, self.signal = None, 0, (0, False)
        self.mm_has_voice = False
        self._drop_all_calls(ORIGIN_CS)
        self._modem_changed(IF_MODEM, "State", "SignalQuality")

    def _on_mm_props(self, conn, sender, path, iface, sig, params):
        if path != self.mm_modem:
            return
        iface, changed, _ = params.unpack()
        self._mm_apply(iface, changed)

    def _on_mm_voice(self, conn, sender, path, iface, sig, params):
        if path != self.mm_modem:
            return
        cpath = params.unpack()[0]
        if sig == "CallAdded":
            self._add_cs_call(cpath)
        elif sig == "CallDeleted":
            self._remove_call(cpath)

    def _on_mm_call_state(self, conn, sender, path, iface, sig, params):
        call = self.calls.get(path)
        if call is None or call.origin != ORIGIN_CS:
            return
        old, new, reason = params.unpack()
        self._set_call_state(call, int(new), int(reason))
        if int(new) == MM_CALL_STATE_TERMINATED:
            # MM keeps terminated calls until deleted; the car must see them go
            self._remove_call(path)

    def _on_mm_om(self, conn, sender, path, iface, sig, params):
        obj, ifs = params.unpack()
        if obj != self.mm_modem:
            if sig == "InterfacesAdded" and IF_MODEM in ifs and self.mm_modem is None:
                self._mm_appeared(conn, MM_SERVICE, sender)
            return
        if sig == "InterfacesAdded" and IF_VOICE in ifs:
            self.mm_has_voice = True
            self._mm_apply(IF_VOICE, ifs[IF_VOICE])
        elif sig == "InterfacesRemoved" and IF_VOICE in ifs:
            self.mm_has_voice = False
            self._drop_all_calls(ORIGIN_CS)
        elif sig == "InterfacesRemoved" and IF_MODEM in ifs:
            self._mm_vanished(conn, MM_SERVICE)
            return
        self._modem_changed(IF_MODEM, "State")

    def _mm_apply(self, iface, p):
        # Only these keys are copied: never IMEI, own numbers or operator code.
        if iface == IF_MODEM:
            keys = []
            if "State" in p:
                self.mm_state = int(p["State"]); keys.append("State")
            if "SignalQuality" in p:
                q = p["SignalQuality"]
                self.signal = (int(q[0]), bool(q[1])); keys.append("SignalQuality")
            if keys:
                self._modem_changed(IF_MODEM, *keys)
        elif iface == IF_VOICE:
            if "EmergencyOnly" in p:
                self.mm_emergency_only = bool(p["EmergencyOnly"])
                self._modem_changed(IF_MODEM, "State")
        elif iface == IF_3GPP:
            keys = []
            if "OperatorName" in p:
                self.operator = str(p["OperatorName"]); keys.append("OperatorName")
            if "RegistrationState" in p:
                self.regstate = int(p["RegistrationState"]); keys.append("RegistrationState")
            if keys:
                self._modem_changed(IF_3GPP, *keys)


def main(argv=None):
    global _print
    ap = argparse.ArgumentParser()
    ap.add_argument("--bus", choices=("system", "session"), default="system",
                    help="bus to own %s on (session only for tests)" % SERVICE)
    ap.add_argument("--ofono-bus", choices=("system", "session"), default="system")
    ap.add_argument("--mm-bus", choices=("system", "session", "none"), default="system")
    ap.add_argument("--audio", choices=("on", "off", "dry"), default=os.environ.get("FP5_HFP_AUDIO", "on"))
    ap.add_argument("--calls-refresh", choices=("on", "off"), default=os.environ.get("FP5_CALLS_REFRESH", "on"),
                    help="restart gnome-calls when it holds a dead oFono modem (idle only)")
    ap.add_argument("--print", action="store_true", help="log to stderr instead of syslog")
    a = ap.parse_args(argv)
    _print = a.print
    syslog.openlog("fp5-hfp-modem-bridge", 0, syslog.LOG_DAEMON)

    def get(kind):
        if kind == "none":
            return None
        return Gio.bus_get_sync(Gio.BusType.SYSTEM if kind == "system" else Gio.BusType.SESSION, None)

    audio = None
    if a.audio != "off":
        import fp5_hfp_audio
        audio = fp5_hfp_audio.AudioRouter(dry=(a.audio == "dry"), log=log)
    bridge = Bridge(get(a.bus), get(a.ofono_bus), get(a.mm_bus), audio=audio)
    if a.calls_refresh == "on" and a.bus == "system":
        bridge.refresher = CallsRefresher(lambda: bool(bridge.live_calls()), log=log)
        bridge.refresher.startup_check()
    if os.environ.get("FP5_GHOST_CALL_FIX", "on") != "off" and a.bus == "system":
        try:
            sesbus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bridge.ghost = GhostCallCheck(lambda: bool(bridge.live_calls()),
                                          lambda: gnome_calls_list(sesbus), log=log)
        except GLib.Error as e:
            log("ghost-call check off: no session bus (%s)" % errname(e), syslog.LOG_WARNING)
    bridge.export()
    loop = GLib.MainLoop()

    acquired = {"ok": False}

    def got(conn, name):
        acquired["ok"] = True
        log("ready on %s" % name)

    def lost(conn, name):
        if not acquired["ok"]:
            log("could not own %s (policy missing or already running)" % name, syslog.LOG_ERR)
        else:
            log("lost %s" % name, syslog.LOG_ERR)
        loop.quit()
    Gio.bus_own_name_on_connection(bridge.bus, SERVICE, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
                                   got, lost)
    bridge.watch_ofono()
    bridge.watch_mm()
    if audio:
        audio.startup_recover()
    try:  # PyGObject >= 3.52 moved it; the old name warns
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        sig_add = GLibUnix.signal_add
    except (ImportError, ValueError, AttributeError):
        sig_add = GLib.unix_signal_add
    for s in (signal.SIGTERM, signal.SIGINT):
        sig_add(GLib.PRIORITY_DEFAULT, s, lambda *x: (loop.quit(), False)[1])
    loop.run()
    if audio:
        audio.shutdown()  # leave the car on A2DP if we stop mid-call or mid-prepare
    # Exit 1 if the name was never acquired, so systemd Restart=on-failure
    # retries (the previous exit 0 left the service dead after a policy miss).
    return 0 if acquired["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
