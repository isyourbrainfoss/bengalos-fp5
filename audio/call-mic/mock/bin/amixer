#!/bin/sh
case "$*" in
 *contents*) printf "numid=1,iface=MIXER,name='ADC1 Switch'\n  ; type=BOOLEAN,access=rw------,values=1\n  : values=on\nnumid=2,iface=MIXER,name='TX DEC0 MUX'\n  ; type=ENUMERATED\n  : values=1\nnumid=3,iface=MIXER,name='RX_RX0 Digital Volume'\n  : values=84\n";;
 *cget*) echo "  : values=on";;
 *cset*) echo "AMIXER $*" >> $MOCK/actions;;
esac
