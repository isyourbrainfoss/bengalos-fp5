#!/bin/sh
M=$MOCK; el=$(awk -v a="$(date +%s.%N)" -v b="$(cat $M/t0)" "BEGIN{print a-b}")
case "$*" in
 *Modem/0*Calls*) echo '{"type":"ao","data":["/org/freedesktop/ModemManager1/Call/0"]}';;
 *Call/0*State*) if awk -v e="$el" -v t="$(cat $M/active_at)" "BEGIN{exit !(e>=t)}"; then echo '{"type":"i","data":4}'; else echo '{"type":"i","data":1}'; fi;;
 *Call/0*Direction*) echo '{"type":"i","data":2}';;
 *) exit 1;;
esac
