# /home/fp5/.config/systemd/user/fp5-call-mic.service
# FP5 call uplink: the voice TX path only gets powered while the mic
# capture stream is open, so hold it open (to /dev/null) during calls.
# Started/stopped by the Mic1 device in UCM Voice Call.
# v2 2026-11-19 (approved t777s3033): waits for the Voice Call mic source,
# records from it by name, re-checks it when the call is answered, logs
# per-call snapshots (journalctl -t fp5-call-mic -t fp5-call-audio).
# v3 2026-11-20 (branch fix/first-call-mic): ADC1 on at once, ~1.5 s level
# check (levels only, no audio kept) and, if the mic is flat, the TX backend
# is reopened so the first call after boot is not silent. Skips car calls.
# v4 2026-11-21 (branch fix/call-mic-ring-adc1): fp5-call-mic-early turns ADC1
# on at ring/dial, before this process starts. If a capture PCM is already
# open and ADC1 was off, the TX backend is reopened immediately. The v3
# flat-mic check is unchanged. Car/HFP still does not touch ADC1.
# UCM files are not part of v4.
# Rollback: sh ~/.local/share/fp5-mic-staging-v4/rollback-mic-v4.sh
[Unit]
Description=Keep mic capture open during voice calls
[Service]
ExecStart=/var/lib/fp5-oot/bin/fp5-call-mic
Restart=on-failure
RestartSec=1
