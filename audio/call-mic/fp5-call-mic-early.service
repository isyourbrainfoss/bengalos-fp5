# /home/fp5/.config/systemd/user/fp5-call-mic-early.service
# v4: always-on. Sets ADC1 Switch at CS ring/dial and at IMS incoming/outgoing
# before the Voice Call profile opens the call PCMs. Does not reopen backends.
# Wanted by default.target. fp5-call-mic.service (UCM) is unchanged.
[Unit]
Description=Turn the call mic port on at ring, before Voice Call PCMs open
[Service]
ExecStart=/var/lib/fp5-oot/bin/fp5-call-mic-early
Restart=on-failure
RestartSec=1
[Install]
WantedBy=default.target
