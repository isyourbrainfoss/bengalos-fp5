From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: isyourbrainfoss <isyourbrainfoss@proton.me>
Date: Sat, 21 Nov 2026 16:30:00 +0000
Subject: [PATCH] simple: spare IMS bearers when disconnecting all

NetworkManager sleeps the modem data connection by calling
Simple.Disconnect with bearer path "/". That disconnects every bearer,
including the IMS PDN fp5-imsd created, so VoLTE drops for suspend.

On that path only, skip a bearer whose config has apn-type IMS, whose
APN is "ims" (case-insensitive), or whose profile-id is 2. fp5-imsd
CreateBearer sets only profile-id 2 and ip-type ipv6; ModemManager does
not copy the stored profile APN back into the bearer config, so the
profile id is what identifies that bearer.

Explicit Simple.Disconnect(path), Bearer.Disconnect, DeleteBearer and
modem disable still disconnect it. If the only bearers left are IMS,
disconnect-all succeeds. One <msg> line names each spared bearer path.

---
--- a/src/mm-bearer-list.h
+++ b/src/mm-bearer-list.h
@@ -83,6 +83,13 @@
                                                    const gchar         *bearer_path,
                                                    GAsyncReadyCallback  callback,
                                                    gpointer             user_data);
+/* Disconnect every bearer except an IMS one. Used only by Simple.Disconnect
+ * of "/" (NetworkManager suspend). Modem disable uses disconnect_bearers().
+ * Hidden so the daemon's dynamic symbol set stays the same as 1.25.95. */
+G_GNUC_INTERNAL
+void     mm_bearer_list_disconnect_bearers_spare_ims (MMBearerList        *self,
+                                                      GAsyncReadyCallback  callback,
+                                                      gpointer             user_data);
 gboolean mm_bearer_list_disconnect_bearers_finish (MMBearerList        *self,
                                                    GAsyncResult        *res,
                                                    GError             **error);
--- a/src/mm-bearer-list.c
+++ b/src/mm-bearer-list.c
@@ -27,6 +27,7 @@
 #include <libmm-glib.h>
 
 #include "mm-bearer-list.h"
+#include "mm-fp5-ims-bearer.h"
 #include "mm-log.h"
 
 G_DEFINE_TYPE (MMBearerList, mm_bearer_list, G_TYPE_OBJECT)
@@ -193,8 +194,22 @@
     gchar        *bearer_path;
     GList        *pending_to_disconnect;
     MMBaseBearer *current_to_disconnect;
+    gboolean      spare_ims;
 } DisconnectBearersContext;
 
+static gboolean
+fp5_bearer_is_ims (MMBaseBearer *bearer)
+{
+    MMBearerProperties *config;
+
+    config = mm_base_bearer_peek_config (bearer);
+    if (mm_fp5_bearer_properties_are_ims (config))
+        return TRUE;
+    /* Connected profile id, filled from the connect result. Profile 2 is the
+     * IMS PDN; the config usually already carries it. */
+    return mm_base_bearer_get_profile_id (bearer) == MM_FP5_IMS_PROFILE_ID;
+}
+
 static void
 disconnect_bearers_context_free (DisconnectBearersContext *ctx)
 {
@@ -257,16 +272,25 @@
 build_connected_bearer_list (MMBaseBearer             *bearer,
                              DisconnectBearersContext *ctx)
 {
+    /* Disconnect-all may spare IMS. A specific bearer path never does:
+     * Simple.Disconnect(path), and any caller that names a path, still
+     * disconnects it. Modem disable uses spare_ims=FALSE. */
+    if (!ctx->bearer_path && ctx->spare_ims && fp5_bearer_is_ims (bearer)) {
+        mm_obj_msg (bearer, "sparing IMS bearer %s", mm_base_bearer_get_path (bearer));
+        return;
+    }
+
     if (!ctx->bearer_path ||
         g_str_equal (ctx->bearer_path, mm_base_bearer_get_path (bearer)))
         ctx->pending_to_disconnect = g_list_prepend (ctx->pending_to_disconnect, g_object_ref (bearer));
 }
 
-void
-mm_bearer_list_disconnect_bearers (MMBearerList        *self,
-                                   const gchar         *bearer_path,
-                                   GAsyncReadyCallback  callback,
-                                   gpointer             user_data)
+static void
+mm_bearer_list_disconnect_bearers_full (MMBearerList        *self,
+                                        const gchar         *bearer_path,
+                                        gboolean             spare_ims,
+                                        GAsyncReadyCallback  callback,
+                                        gpointer             user_data)
 {
     GTask                    *task;
     DisconnectBearersContext *ctx;
@@ -274,10 +298,13 @@
     task = g_task_new (self, NULL, callback, user_data);
     ctx = g_slice_new0 (DisconnectBearersContext);
     ctx->bearer_path = g_strdup (bearer_path);  /* may be NULL if disconnecting all */
+    ctx->spare_ims = spare_ims;
     g_task_set_task_data (task, ctx, (GDestroyNotify)disconnect_bearers_context_free);
 
     /* If a given specific bearer is being disconnected, only add that one. Otherwise,
-     * disconnect all. */
+     * disconnect all (optionally skipping IMS bearers). An empty list is success:
+     * NetworkManager expects Simple.Disconnect("/") to succeed when the only
+     * bearers left are ones we spared. */
     mm_bearer_list_foreach (self, (MMBearerListForeachFunc)build_connected_bearer_list, ctx);
 
     if (ctx->bearer_path && !ctx->pending_to_disconnect) {
@@ -291,6 +318,23 @@
     disconnect_bearers_next (task);
 }
 
+void
+mm_bearer_list_disconnect_bearers (MMBearerList        *self,
+                                   const gchar         *bearer_path,
+                                   GAsyncReadyCallback  callback,
+                                   gpointer             user_data)
+{
+    mm_bearer_list_disconnect_bearers_full (self, bearer_path, FALSE, callback, user_data);
+}
+
+void
+mm_bearer_list_disconnect_bearers_spare_ims (MMBearerList        *self,
+                                             GAsyncReadyCallback  callback,
+                                             gpointer             user_data)
+{
+    mm_bearer_list_disconnect_bearers_full (self, NULL, TRUE, callback, user_data);
+}
+
 /*****************************************************************************/
 
 #if defined WITH_SUSPEND_RESUME
--- a/src/mm-iface-modem-simple.c
+++ b/src/mm-iface-modem-simple.c
@@ -1055,15 +1055,21 @@
         return;
     }
 
-    if (ctx->bearer_path)
+    /* Only Simple.Disconnect("/") / empty path spares IMS. A path argument,
+     * Bearer.Disconnect and modem disable (which calls disconnect_bearers
+     * with a NULL path itself) still disconnect the IMS bearer. */
+    if (ctx->bearer_path) {
         mm_obj_info (self, "processing user request to disconnect modem: bearer '%s'", ctx->bearer_path);
-    else
+        mm_bearer_list_disconnect_bearers (list,
+                                           ctx->bearer_path,
+                                           (GAsyncReadyCallback)bearer_list_disconnect_bearers_ready,
+                                           ctx);
+    } else {
         mm_obj_info (self, "processing user request to disconnect modem: all bearers");
-
-    mm_bearer_list_disconnect_bearers (list,
-                                       ctx->bearer_path,
-                                       (GAsyncReadyCallback)bearer_list_disconnect_bearers_ready,
-                                       ctx);
+        mm_bearer_list_disconnect_bearers_spare_ims (list,
+                                                     (GAsyncReadyCallback)bearer_list_disconnect_bearers_ready,
+                                                     ctx);
+    }
 }
 
 static gboolean
--- a/src/tests/meson.build
+++ b/src/tests/meson.build
@@ -64,6 +64,17 @@
 
 test('test-base-call', exe, suite: 'daemon', env: test_env)
 
+# FP5 IMS bearer predicate (header-only; no daemon objects)
+exe = executable(
+  'test-fp5-ims-bearer',
+  sources: 'test-fp5-ims-bearer.c',
+  include_directories: [top_inc, src_inc],
+  dependencies: libmm_glib_dep,
+  c_args: c_args,
+)
+
+test('test-fp5-ims-bearer', exe, suite: 'daemon', env: test_env)
