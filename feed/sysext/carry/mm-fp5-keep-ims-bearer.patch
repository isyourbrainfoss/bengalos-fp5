 if get_option('fuzzer')
   fuzzer_tests = ['test-sms-part-3gpp-fuzzer',
--- a/src/mm-fp5-ims-bearer.h
+++ b/src/mm-fp5-ims-bearer.h
@@ -0,0 +1,53 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * FP5: identify an IMS bearer from its ModemManager config.
+ *
+ * Simple.Disconnect("/") is how NetworkManager sleeps the modem data
+ * connection. That path must not tear down the IMS PDN. fp5-imsd creates
+ * its bearer with only profile-id 2 and ip-type ipv6 (see transaction.py
+ * CreateBearer). ModemManager loads APN "ims" from the stored profile at
+ * connect time and does not copy it back into the bearer config, so the
+ * profile id is what identifies that bearer. An explicit APN "ims" or
+ * apn-type IMS is also spared, for a bearer configured that way directly.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef MM_FP5_IMS_BEARER_H
+#define MM_FP5_IMS_BEARER_H
+
+#include <glib.h>
+#include <ModemManager.h>
+#include <libmm-glib.h>
+
+/* MBN profile fp5-imsd binds with CreateBearer profile-id=2. */
+#define MM_FP5_IMS_PROFILE_ID 2
+
+static inline gboolean
+mm_fp5_bearer_properties_are_ims (MMBearerProperties *config)
+{
+    const gchar *apn;
+    MMBearerApnType apn_type;
+
+    if (!config)
+        return FALSE;
+
+    apn_type = mm_bearer_properties_get_apn_type (config);
+    if (apn_type & MM_BEARER_APN_TYPE_IMS)
+        return TRUE;
+
+    apn = mm_bearer_properties_get_apn (config);
+    if (apn && apn[0] && g_ascii_strcasecmp (apn, "ims") == 0)
+        return TRUE;
+
+    /* CreateBearer {profile-id: 2, ip-type: ipv6} has neither field above. */
+    if (mm_bearer_properties_get_profile_id (config) == MM_FP5_IMS_PROFILE_ID)
+        return TRUE;
+
+    return FALSE;
+}
+
+#endif /* MM_FP5_IMS_BEARER_H */
--- a/src/tests/test-fp5-ims-bearer.c
+++ b/src/tests/test-fp5-ims-bearer.c
@@ -0,0 +1,110 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Predicate used by Simple.Disconnect("/") to spare the FP5 IMS bearer.
+ */
+
+#include <glib.h>
+#include <libmm-glib.h>
+
+#include "mm-fp5-ims-bearer.h"
+
+static MMBearerProperties *
+props (const gchar *apn,
+       MMBearerApnType apn_type,
+       gint profile_id,
+       MMBearerIpFamily ip_type)
+{
+    MMBearerProperties *config;
+
+    config = mm_bearer_properties_new ();
+    if (apn)
+        mm_bearer_properties_set_apn (config, apn);
+    if (apn_type != MM_BEARER_APN_TYPE_NONE)
+        mm_bearer_properties_set_apn_type (config, apn_type);
+    if (profile_id != MM_3GPP_PROFILE_ID_UNKNOWN)
+        mm_bearer_properties_set_profile_id (config, profile_id);
+    if (ip_type != MM_BEARER_IP_FAMILY_NONE)
+        mm_bearer_properties_set_ip_type (config, ip_type);
+    return config;
+}
+
+static void
+test_null_and_empty (void)
+{
+    g_autoptr(MMBearerProperties) empty = NULL;
+
+    g_assert_false (mm_fp5_bearer_properties_are_ims (NULL));
+    empty = props (NULL, MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    g_assert_false (mm_fp5_bearer_properties_are_ims (empty));
+}
+
+static void
+test_apn_ims (void)
+{
+    g_autoptr(MMBearerProperties) lower = NULL;
+    g_autoptr(MMBearerProperties) upper = NULL;
+    g_autoptr(MMBearerProperties) mixed = NULL;
+    g_autoptr(MMBearerProperties) prefix = NULL;
+    g_autoptr(MMBearerProperties) other = NULL;
+
+    lower = props ("ims", MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    upper = props ("IMS", MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    mixed = props ("Ims", MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    prefix = props ("ims.example", MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    other = props ("internet", MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+
+    g_assert_true (mm_fp5_bearer_properties_are_ims (lower));
+    g_assert_true (mm_fp5_bearer_properties_are_ims (upper));
+    g_assert_true (mm_fp5_bearer_properties_are_ims (mixed));
+    g_assert_false (mm_fp5_bearer_properties_are_ims (prefix));
+    g_assert_false (mm_fp5_bearer_properties_are_ims (other));
+}
+
+static void
+test_apn_type (void)
+{
+    g_autoptr(MMBearerProperties) ims = NULL;
+    g_autoptr(MMBearerProperties) both = NULL;
+    g_autoptr(MMBearerProperties) internet = NULL;
+
+    ims = props (NULL, MM_BEARER_APN_TYPE_IMS, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    both = props ("internet", MM_BEARER_APN_TYPE_IMS | MM_BEARER_APN_TYPE_DEFAULT, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+    internet = props (NULL, MM_BEARER_APN_TYPE_DEFAULT, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_NONE);
+
+    g_assert_true (mm_fp5_bearer_properties_are_ims (ims));
+    g_assert_true (mm_fp5_bearer_properties_are_ims (both));
+    g_assert_false (mm_fp5_bearer_properties_are_ims (internet));
+}
+
+static void
+test_supervisor_profile (void)
+{
+    g_autoptr(MMBearerProperties) supervisor = NULL;
+    g_autoptr(MMBearerProperties) data = NULL;
+    g_autoptr(MMBearerProperties) ipv6_only = NULL;
+
+    /* transaction.py CreateBearer: profile-id 2, ip-type ipv6 (value 2). */
+    supervisor = props (NULL, MM_BEARER_APN_TYPE_NONE, MM_FP5_IMS_PROFILE_ID, MM_BEARER_IP_FAMILY_IPV6);
+    g_assert_cmpuint (mm_bearer_properties_get_ip_type (supervisor), ==, 2);
+    g_assert_true (mm_fp5_bearer_properties_are_ims (supervisor));
+
+    data = props ("internet", MM_BEARER_APN_TYPE_DEFAULT, 1, MM_BEARER_IP_FAMILY_IPV4V6);
+    g_assert_false (mm_fp5_bearer_properties_are_ims (data));
+
+    /* IPv6 alone is not IMS; a data bearer can request it. */
+    ipv6_only = props (NULL, MM_BEARER_APN_TYPE_NONE, MM_3GPP_PROFILE_ID_UNKNOWN, MM_BEARER_IP_FAMILY_IPV6);
+    g_assert_false (mm_fp5_bearer_properties_are_ims (ipv6_only));
+}
+
+int
+main (int argc, char **argv)
+{
+    g_test_init (&argc, &argv, NULL);
+
+    g_test_add_func ("/fp5/ims-bearer/null-empty", test_null_and_empty);
+    g_test_add_func ("/fp5/ims-bearer/apn", test_apn_ims);
+    g_test_add_func ("/fp5/ims-bearer/apn-type", test_apn_type);
+    g_test_add_func ("/fp5/ims-bearer/supervisor-profile", test_supervisor_profile);
+
+    return g_test_run ();
+}
