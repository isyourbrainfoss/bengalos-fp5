diff --git a/src/monitor/output-scale.h b/src/monitor/output-scale.h
new file mode 100644
index 00000000..1c5e479b
--- /dev/null
+++ b/src/monitor/output-scale.h
@@ -0,0 +1,56 @@
+/*
+ * Copyright (C) 2026 The Phosh Developers
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Decide whether a scale may be sent with
+ * zwlr_output_configuration_head_v1.set_scale.
+ *
+ * wlroots 0.20 (types/wlr_output_management_v1.c,
+ * config_head_handle_set_scale) posts error 5, "invalid scale", when the
+ * fixed-point value is <= 0. That is a protocol error: libwayland drops
+ * the client, so phosh exits. A disabled head never receives a scale
+ * event (the protocol sends scale only while the head is enabled), so
+ * PhoshHead.pending.scale stays 0. Enabling that head and echoing 0 —
+ * phosh_monitor_manager_enable_fallback does this after the primary
+ * monitor goes NULL — kills the shell.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <wayland-util.h>
+
+/**
+ * phosh_output_scale_to_fixed:
+ * @scale: candidate scale
+ * @out_fixed: (out) (nullable): wl_fixed value, written only on success
+ *
+ * Returns: %TRUE if @scale is strictly positive and survives the
+ * round-trip through wl_fixed (24.8). NaN, 0, negatives, and positive
+ * values that round to fixed 0 are rejected. A rejected value must not
+ * be passed to set_scale; the caller omits the request and the
+ * compositor keeps the scale it already copied into the configuration
+ * head (wlroots defaults a fresh output to 1).
+ *
+ * Valid scales (1, 1.25, 1.5, 2, 2.5, 3, …) are returned unchanged.
+ */
+static inline bool
+phosh_output_scale_to_fixed (double scale, int32_t *out_fixed)
+{
+  int32_t fixed;
+
+  /* NaN compares false against every relational operator. */
+  if (!(scale > 0.0))
+    return false;
+
+  fixed = (int32_t) wl_fixed_from_double (scale);
+  if (fixed <= 0)
+    return false;
+
+  if (out_fixed)
+    *out_fixed = fixed;
+  return true;
+}
