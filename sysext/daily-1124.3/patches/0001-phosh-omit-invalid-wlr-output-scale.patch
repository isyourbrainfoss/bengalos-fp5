diff --git a/tests/test-output-scale.c b/tests/test-output-scale.c
new file mode 100644
index 00000000..f00e29a4
--- /dev/null
+++ b/tests/test-output-scale.c
@@ -0,0 +1,70 @@
+/*
+ * Copyright (C) 2026 The Phosh Developers
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Unit test for phosh_output_scale_to_fixed(). The helper is what
+ * monitor-manager uses before zwlr_output_configuration_head_v1.set_scale.
+ */
+
+#include "output-scale.h"
+
+#include <glib.h>
+#include <math.h>
+
+static void
+test_rejects_non_positive (void)
+{
+  int32_t fixed = 42;
+
+  g_assert_false (phosh_output_scale_to_fixed (0.0, &fixed));
+  g_assert_cmpint (fixed, ==, 42);
+  g_assert_false (phosh_output_scale_to_fixed (-1.0, &fixed));
+  g_assert_false (phosh_output_scale_to_fixed (-0.25, &fixed));
+  g_assert_false (phosh_output_scale_to_fixed (NAN, &fixed));
+  g_assert_cmpint (fixed, ==, 42);
+  g_assert_false (phosh_output_scale_to_fixed (0.0, NULL));
+}
+
+static void
+test_accepts_known_scales (void)
+{
+  static const double scales[] = { 1.0, 1.25, 1.5, 2.0, 2.5, 3.0 };
+  guint i;
+
+  g_assert_true (phosh_output_scale_to_fixed (2.0, NULL));
+
+  for (i = 0; i < G_N_ELEMENTS (scales); i++) {
+    int32_t fixed = 0;
+
+    g_assert_true (phosh_output_scale_to_fixed (scales[i], &fixed));
+    g_assert_cmpint (fixed, ==, (int32_t) wl_fixed_from_double (scales[i]));
+    g_assert_cmpint (fixed, >, 0);
+  }
+}
+
+static void
+test_tiny_positive_that_rounds_to_zero (void)
+{
+  /* 24.8 fixed cannot represent 1e-6; wl_fixed_from_double rounds it to 0
+   * and wlroots would post invalid_scale. */
+  double tiny = 1.0 / 1000000.0;
+  int32_t fixed = 42;
+  wl_fixed_t raw = wl_fixed_from_double (tiny);
+
+  g_assert_cmpint (raw, <=, 0);
+  g_assert_false (phosh_output_scale_to_fixed (tiny, &fixed));
+  g_assert_cmpint (fixed, ==, 42);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/phosh/output-scale/rejects-non-positive", test_rejects_non_positive);
+  g_test_add_func ("/phosh/output-scale/accepts-known-scales", test_accepts_known_scales);
+  g_test_add_func ("/phosh/output-scale/tiny-positive", test_tiny_positive_that_rounds_to_zero);
+
+  return g_test_run ();
+}
